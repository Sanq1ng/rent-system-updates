      const started = generation;
      const result = await hello();
      guard(started);
      if (result.print !== true) throw failure("这个安卓客户端尚不支持直接打印报表，请导出表格或在电脑浏览器中打印。", "NATIVE_PRINT_UNAVAILABLE");
