    function exchange(type, expected, id, data = {}, timeout = 15000) {
      return new Promise((resolve, reject) => {
        const finish = (action, value) => {
          const entry = pending.get(id);
          if (!entry) return;
          environment.clearTimeout(entry.timer);
          pending.delete(id);
          action(value);
        };
