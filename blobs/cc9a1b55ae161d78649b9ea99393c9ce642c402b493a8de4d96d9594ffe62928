        throw failure("安卓账号状态变更原因无效。", "NATIVE_SESSION_CHANGED");
      }
      generation++;
      capabilities = null;
      for (const entry of pending.values()) entry.reject(failure("账号或工作区已切换，旧文件操作已取消。", "NATIVE_SESSION_CHANGED"));
      busy = false; activeId = "";
      if (available()) send("session-changed", environment.crypto.randomUUID(), reason ? { reason } : {});
