        guard(started);
        if (result.storage !== "app-private") throw failure("安卓客户端尚未确认文件完整写入，请不要删除原文件。");
        return result;
      } catch (error) {
        if (available()) {
          try { send("export-abort", id); }
          catch (abortError) { throw new AggregateError([error, abortError], "安卓文件操作和取消确认均未完成，请保留原文件并重新打开客户端。"); }
        }
