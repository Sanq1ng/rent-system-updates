    }
    async function accountReady({ serverId, userId }) {
      if (!available()) throw failure("安卓账号通知接口不可用，请先更新客户端或 Android System WebView。", "NATIVE_SESSION_CHANGED");
      if (!UUID.test(serverId || "") || !UUID.test(userId || "")) {
        throw failure("安卓账号或账套标识无效，不能保留旧设备授权。", "NATIVE_SESSION_CHANGED");
      }
      const started = generation;
      const limits = await hello();
      guard(started);
      if (limits.workspaceIdentity !== true || limits.lifecycleReasons !== true) {
        throw failure("请先更新安卓客户端以保护账号文件与通知；不要卸载或清除本机资料。", "NATIVE_UPDATE_REQUIRED");
      }
      const identity = `${serverId.toLowerCase()}:${userId.toLowerCase()}`;
      if (environment.localStorage.getItem(ACCOUNT_KEY) !== identity) sessionChanged("account-switch");
      send("workspace-ready", environment.crypto.randomUUID(), { serverId: serverId.toLowerCase(), userId: userId.toLowerCase() });
      environment.localStorage.setItem(ACCOUNT_KEY, identity);
    }
