    internal sealed class FirewallPlan
    {
        public string programDirectory;
        public string serverId;
        public string runId;
        public string ownerSid;
        public string address;
        public int prefixLength;
        public int port;
        public bool includeDomain;
        public bool discovery;
        public OfficeIdentity officeNetwork;
        internal string Name { get { return "IndustrialRent-LAN-" + serverId + "-" + runId + (discovery ? "-discovery" : ""); } }
        internal string Program { get { return Path.Combine(programDirectory, "runtime", "node.exe"); } }
        internal string Subnet { get { return Network.Subnet(address, prefixLength); } }
        internal int Profiles { get { return includeDomain ? 3 : 2; } }
        internal string Tag
        {
            get
            {
                return "industrial-rent-lan:v1:" + serverId + ":" + runId + ":" + ownerSid + ":" +
                    Product.Hash(Product.Utf8.GetBytes(programDirectory.ToLowerInvariant() + "\n" + address + "\n" + Subnet + "\n" + port + "\n" + Profiles +
                        (officeNetwork == null ? "" : "\n" + officeNetwork.Tag) + (discovery ? "\ndiscovery-v1" : "")));
            }
        }
        internal void Validate()
        {
            Paths.Absolute(programDirectory, false); Product.Uuid(serverId); Product.Uuid(runId);
            Network.PrivateV4(address); Network.Port(port); Network.Subnet(address, prefixLength);
            if (discovery && port != 48765) throw new IOException("同网发现只允许固定 UDP 48765 端口。");
            if (ownerSid == null || !Regex.IsMatch(ownerSid, @"^S-1-(?:5-21|12-1)-[0-9]{1,10}-[0-9]{1,10}-[0-9]{1,10}-[0-9]{1,10}$"))
                throw new IOException("防火墙规则必须登记到明确的本机 Windows 用户 SID。");
            new SecurityIdentifier(ownerSid);
            Paths.Absolute(Program, false);
            if (officeNetwork != null)
            {
                officeNetwork.Validate();
                if (includeDomain != (officeNetwork.category == 2)) throw new IOException("办公网络类别与授权范围不一致。");
            }
        }
        internal FirewallRule Expected()
        {
            Validate();
            return new FirewallRule {
                name = Name, application = Program, description = Tag, grouping = "IndustrialRent LAN",
                protocol = discovery ? 17 : 6, localPorts = port.ToString(CultureInfo.InvariantCulture), remotePorts = "*",
                localAddress = discovery ? "*" : address, remoteAddress = Subnet, profiles = Profiles, direction = 1, action = 1,
                enabled = true, edgeTraversal = false, interfaceTypes = "All", interfaces = "", service = ""
            };
        }
        internal FirewallPlan DiscoveryPlan()
        {
            var copy = Json.Decode<FirewallPlan>(Json.Encode(this));
            copy.discovery = true; copy.port = 48765; copy.Validate(); return copy;
        }
        internal string[] Args(string mode)
        {
            Validate();
            var result = new System.Collections.Generic.List<string> { mode, "--program", programDirectory, "--server-id", serverId, "--run-id", runId,
                "--owner-sid", ownerSid, "--address", address, "--prefix-length", prefixLength.ToString(CultureInfo.InvariantCulture),
                "--port", port.ToString(CultureInfo.InvariantCulture), "--profiles", includeDomain ? "private-domain" : "private" };
            if (discovery) result.AddRange(new[] { "--purpose", "discovery" });
            if (officeNetwork != null) result.AddRange(new[] { "--office-adapter", officeNetwork.adapterId,
                "--office-connection", officeNetwork.connectionId, "--office-network", officeNetwork.networkId,
                "--office-category", officeNetwork.category.ToString(CultureInfo.InvariantCulture) });
            return result.ToArray();
        }
    }
    internal sealed class FirewallRule
    {
        public string name, application, description, grouping, localPorts, remotePorts, localAddress, remoteAddress, interfaceTypes, interfaces, service;
        public int protocol, profiles, direction, action;
        public bool enabled, edgeTraversal;
        internal bool Same(FirewallRule other)
        {
            return other != null && name == other.name && String.Equals(application, other.application, StringComparison.OrdinalIgnoreCase) &&
                description == other.description && grouping == other.grouping && localPorts == other.localPorts &&
                remotePorts == other.remotePorts && localAddress == other.localAddress && remoteAddress == other.remoteAddress &&
                protocol == other.protocol && profiles == other.profiles && direction == other.direction && action == other.action &&
                enabled == other.enabled && edgeTraversal == other.edgeTraversal && interfaceTypes == other.interfaceTypes &&
                interfaces == other.interfaces && service == other.service;
        }
    }
    internal interface IFirewallStore
    {
        FirewallRule Find(string name);
        void Add(FirewallRule rule);
        void Remove(string name);
    }
    internal interface INetworkGate { void RequireTrusted(FirewallPlan plan); }

    [ComImport, Guid("DCB00005-570F-4A9B-8D69-199FDBA5723B"), InterfaceType(ComInterfaceType.InterfaceIsDual)]
    internal interface INetworkConnection
    {
        [return: MarshalAs(UnmanagedType.Interface)] object GetNetwork();
        [return: MarshalAs(UnmanagedType.VariantBool)] bool IsConnectedToInternet();
