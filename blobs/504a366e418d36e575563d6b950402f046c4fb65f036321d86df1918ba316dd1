"use strict";

const { normalizePark } = require("../public/business.js");

const DEFAULT_PARKS = Object.freeze(["浔涌园区", "德邦园区", "恒动园区"]);

function directory(store) {
  const legacy = new Set();
  const add = name => {
    const value = normalizePark(name);
    if (value && !DEFAULT_PARKS.includes(value)) legacy.add(value);
  };
  const addLocations = data => {
    for (const location of data?.locations || []) add(location.park);
  };
  for (const user of store.all("users")) for (const name of user.parks) add(name);
  for (const contract of store.all("contracts")) {
    addLocations(contract.data);
    for (const version of contract.versions || []) addLocations(version.data);
  }
  for (const application of store.all("applications")) {
    addLocations(application.payload?.data);
    for (const version of application.versions || []) addLocations(version.payload?.data);
  }
  // 旧名称保持独立，绝不猜测归属或把历史授权自动扩大到新园区。
  return [
    ...DEFAULT_PARKS.map(name => ({ name, legacy: false })),
    ...[...legacy].sort((a, b) => a.localeCompare(b, "zh-CN")).map(name => ({ name, legacy: true })),
  ];
}

function visibleDirectory(store, user) {
  return directory(store).filter(entry =>
    user.roles.includes("admin") || user.allParks || user.parks.includes(entry.name));
}

module.exports = { DEFAULT_PARKS, directory, visibleDirectory };
