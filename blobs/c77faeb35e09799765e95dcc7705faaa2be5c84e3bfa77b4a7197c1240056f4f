      }
      const { DatabaseSync } = require("node:sqlite");
      const database = new DatabaseSync(path.toNamespacedPath(path.join(config.dataDir, "rent.sqlite")), { readOnly: true });
      try {
        if (database.prepare("PRAGMA user_version").get().user_version !== expectedStartupSchema ||
            state.job.fullProgram && !state.job.nativeApplied) {
          fail("UPDATE_COMPATIBILITY", "试运行只允许主机兼容的既有格式账本；不会自动升级或新建账本。");
        }
      } finally { database.close(); }
    } else if (state.job && !TERMINAL.has(state.job.phase)) {
      patchJob({ phase: "failed", error: { code: "UPDATE_INTERRUPTED", message: "上次更新在交接前中断，原程序继续运行；请重新发起更新。" } });
    }
  }
  function bindApplication(value) {
    application = value;
    if (startupHandoff && !recoveryJob) {
      if (!supported()) fail("UPDATE_COMPATIBILITY", "候选程序缺少安全维护接口。");
      const identity = application.getUpdateIdentity();
      if (identity.serverId !== state.job.identity?.serverId || identity.schemaVersion !== expectedStartupSchema ||
          identity.applicationVersion !== active.version || !state.job.fullProgram && state.job.identity.schemaVersion !== identity.schemaVersion) {
        fail("UPDATE_IDENTITY", "候选程序的账套、数据库格式或版本不符；未解除维护。");
      }
    }
    scheduleAutomatic(autoStartDelayMilliseconds);
  }
  async function commitStartup(jobId) {
    if (!startupHandoff || recoveryJob || jobId !== state.job.id || !["trial", "rollback-trial"].includes(state.job.phase)) {
      fail("UPDATE_STATE", "更新启动确认不属于当前试运行。");
    }
    const rolledBack = state.job.phase === "rollback-trial";
    if (!rolledBack) {
      state.highestSequence = Math.max(state.highestSequence, state.staged.manifest.sequence);
      state.installedEnvelope = state.staged.envelope;
    }
    state.available = null;
    state.staged = null;
    state.activeReleaseId = active.releaseId;
    patchJob({ phase: rolledBack ? "rolled-back" : "committed" });
    await application.finishUpdateMaintenance({ windowId: state.job.windowId, outcome: rolledBack ? "rolled-back" : "committed" });
    if (state.job.fullProgram) {
      const file = require("./full-apply.cjs").receiptFile(storage);
      if (fs.existsSync(file)) {
        const receipt = require("./files.cjs").readJSON(file);
        if (receipt.jobId !== jobId || receipt.sourceId !== active.releaseId ||
            !state.job.nativeApplied || !["copying", "trial"].includes(receipt.phase))
          fail("UPDATE_STATE", "整程序交接收据不符，未删除其他记录。");
        fs.unlinkSync(file);
      }
    }
  }
  function confirmCompletion() {
    const job = state.job;
    if (!job?.fullProgram || !["committed", "rolled-back"].includes(job.phase)) return null;
    const identity = application?.getUpdateIdentity();
    const version = job.phase === "rolled-back" ? job.identity.applicationVersion : job.targetVersion;
    if (!job.nativeApplied || identity?.serverId !== job.identity.serverId ||
        identity.applicationVersion !== version || active.version !== version ||
        application.getUpdateGateStatus().phase !== "idle") {
      fail("UPDATE_IDENTITY", "更新完成通知与当前主机身份或就绪状态不符，未声明成功。");
    }
    return publishOutcome(storage, { jobId: job.id, phase: job.phase, version, serverId: identity.serverId });
  }
  function scheduleAutomatic(delay) {
    if (!autoDownload || !configured || disposed || closing || automaticTimer) return;
    automaticTimer = setTimeout(async () => {
      automaticTimer = null;
      const context = { actorId: "$automatic-download", authorize: () => "$automatic-download", background: automaticAuthority };
      try {
        if (!running && (!state.job || TERMINAL.has(state.job.phase))) {
          await check({ requestId: crypto.randomUUID() }, context);
          if (running) await running;
          if (state.job?.phase === "completed" && state.available && state.staged?.releaseId !== state.available.releaseId) {
            await stage({ requestId: crypto.randomUUID(), releaseId: state.available.releaseId }, context);
            if (running) await running;
          }
        }
      } catch (error) { logFailure("自动下载更新未完成", "automatic", error); }
      finally { scheduleAutomatic(autoIntervalMilliseconds); }
    }, delay);
    automaticTimer.unref();
  }
  async function beforeStop() {
    closing = true;
    clearTimeout(automaticTimer); automaticTimer = null;
    if (aborter && !HANDOFF.has(state.job?.phase)) aborter.abort();
    if (running) await running;
  }
  function dispose() {
    disposed = true;
    clearTimeout(automaticTimer); automaticTimer = null;
    if (aborter && !HANDOFF.has(state.job?.phase)) aborter.abort();
    if (releaseLease) { const release = releaseLease; releaseLease = null; release(); }
  }

  return {
    api: { status, check, stage, install, cancel, clientRelease, openClientFile },
    get bootMaintenance() { return bootMaintenance; },
    get recoveryJob() { return recoveryJob; },
    get active() { return active; },
    prepareStartup, bindApplication, commitStartup, confirmCompletion, beforeStop, dispose,
    get startupJobId() { return startupHandoff ? state.job.id : null; },
    async settled() { if (running) await running; },
  };
}

module.exports = { createUpdateController };
