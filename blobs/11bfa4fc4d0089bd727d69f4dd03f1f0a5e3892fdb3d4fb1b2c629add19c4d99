    internal static class Pe
    {
        internal static void Require(Stream stream, bool gui)
        {
            if (stream.Length < 512 || stream.Length > 128 * 1024 * 1024) throw new IOException("可执行文件大小不合理。");
            stream.Position = 0;
            var reader = new BinaryReader(stream);
            if (reader.ReadUInt16() != 0x5a4d) throw new IOException("不是 Windows 可执行文件。");
            stream.Position = 0x3c; uint offset = reader.ReadUInt32();
            if (offset < 64 || offset + 96 > stream.Length) throw new IOException("PE 头部越界。");
            stream.Position = offset;
            if (reader.ReadUInt32() != 0x4550 || reader.ReadUInt16() != 0x8664) throw new IOException("必须使用 Windows x64 可执行文件。");
            stream.Position = offset + 24;
            if (reader.ReadUInt16() != 0x20b) throw new IOException("必须使用 PE32+ x64 可执行文件。");
            stream.Position = offset + 24 + 68;
            if (reader.ReadUInt16() != (gui ? 2 : 3)) throw new IOException("Windows 程序子系统类型不正确。");
            stream.Position = 0;
        }
    }
    internal sealed class InterfaceChoice
    {
        public string name { get; set; }
        public string address { get; set; }
        public string subnet { get; set; }
        public int prefixLength { get; set; }
        public override string ToString() { return name + "  " + address + "/" + prefixLength + "（仅允许 " + subnet + "）"; }
        internal void Validate()
        {
            if (String.IsNullOrEmpty(name) || name.Length > 512 || name.Any(Char.IsControl) || subnet != Network.Subnet(address, prefixLength))
                throw new IOException("主机返回的网卡或子网信息无效。");
        }
    }
    internal sealed class LanStatus
    {
        public string format { get; set; }
        public int formatVersion { get; set; }
        public string configFile { get; set; }
        public string programDirectory { get; set; }
        public string dataDir { get; set; }
        public string backupDir { get; set; }
        public string updateDir { get; set; }
        public string serverId { get; set; }
        public string sourceOrigin { get; set; }
        public bool initialized { get; set; }
        public bool lanEnabled { get; set; }
        public bool addressChanged { get; set; }
        public bool recoveryAvailable { get; set; }
        public int port { get; set; }
        public string certificateDirectory { get; set; }
        public InterfaceChoice[] interfaces { get; set; }
        internal void Validate(string program, string explicitConfig)
        {
            if (format != "industrial-rent-lan-status" || formatVersion != 1 ||
                !String.Equals(Paths.Absolute(programDirectory, false), program, StringComparison.OrdinalIgnoreCase))
                throw new IOException("主机状态协议或程序目录不匹配。");
            Paths.Absolute(configFile, false); Paths.Absolute(dataDir, false); Paths.Absolute(backupDir, false);
            if (updateDir != null) Paths.Absolute(updateDir, false);
            if (explicitConfig != null && !String.Equals(configFile, explicitConfig, StringComparison.OrdinalIgnoreCase))
                throw new IOException("返回的配置不是明确指定的原配置；不能操作另一套安装。");
            if (initialized) Product.Uuid(serverId);
            Network.Port(port);
            if (interfaces == null || interfaces.Length > 128) throw new IOException("网卡列表缺失或过大。");
            foreach (InterfaceChoice choice in interfaces) choice.Validate();
            if (certificateDirectory != null) Paths.Absolute(certificateDirectory, false);
            if (String.IsNullOrEmpty(sourceOrigin) || sourceOrigin.Length > 2048 || sourceOrigin.Any(Char.IsControl))
                throw new IOException("原来源记录无效。");
        }
    }
