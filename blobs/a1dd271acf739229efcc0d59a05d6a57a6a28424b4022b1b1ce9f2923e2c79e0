            menu.Items.Add("导出故障信息", null, (sender, e) => ExportSupport());
            menu.Items.Add("退出软件", null, async (sender, e) => await ExitSafely());
            tray.ContextMenuStrip = menu; tray.DoubleClick += (sender, e) => OpenTarget(null);
            search.Click += async (sender, e) => await Search();
            connect.Click += async (sender, e) => await Join();
            hosts.SelectedIndexChanged += (sender, e) => connect.Enabled =
                hosts.SelectedItem is Offer && !discovering && !joining && state.Company == null;
            update.Click += async (sender, e) => await ApplyDownloadedUpdate();
            recover.Click += async (sender, e) => {
                try { await StartBrowser(null); } catch (Exception error) { Fail(error); }
            };
            pollTimer.Tick += async (sender, e) => {
                await Poll();
                if (clientUpdates.Enabled && state.Company != null && !checkingUpdate && DateTime.UtcNow >= nextUpdate) await CheckUpdate();
