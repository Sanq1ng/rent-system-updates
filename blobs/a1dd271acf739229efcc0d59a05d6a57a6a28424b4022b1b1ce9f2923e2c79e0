        internal ClientWindow(Options options, ClientState state, WindowsNotices notices, Func<PairingSession, Offer[]> discover = null)
        {
            this.options = options; this.state = state; this.notices = notices;
            this.discover = discover ?? (session => session.Discover());
            clientUpdates = new ClientUpdates(options.Isolated);
            Text = "园区租赁"; Font = new Font("Microsoft YaHei UI", 10);
            StartPosition = FormStartPosition.CenterScreen; Size = new Size(1180, 790); MinimumSize = new Size(850, 600);
