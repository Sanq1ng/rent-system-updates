      if (["edit-freeEnabled", "edit-lessorId", "edit-cycleMonths"].includes(el.id) || el.dataset.key === "frequency") { render(); return; }
      if (el.dataset.files) {
        if (!vault) throw new Error("工作区尚未解锁，无法缓存附件。");
        if (!offlineAccess()) return;
        const group = el.dataset.files;
        const startedIn = workspaceEpoch, editor = ui.editor, action = ui.action;
        const assertForm = () => {
          assertWorkspace(startedIn);
          if (group === "contract" ? ui.editor !== editor : ui.action !== action)
            throw new Error("选择文件期间表单已切换；未把文件附加到新表单，请重新选择。");
        };
        for (const file of el.files) {
          if (!offlineAccess()) return;
          const result = await Offline.cacheFile(file);
          assertForm();
          await saveVault(value => { value.files[result.attachment.id] = result.record; });
          assertForm();
          if (group === "contract") {
            ui.editor.data.attachments.push(result.attachment);
            ui.editorDirty = true;
            await saveEditor();
          } else {
            if (!ui.action) throw new Error("收款表单已关闭，请重新选择附件。");
            ui.action.attachments.push(result.attachment);
            document.getElementById("action-attachments").innerHTML = ui.action.attachments.map(attachmentLink).join("<br>");
          }
        }
        if (group === "contract") render();
        toast(`${el.files.length} 份附件已保存到本机，随申请同步上传。`);
      }
    } catch (error) { showError(error); }
    finally {
      if (trackFile && startedWorkIn === workspaceEpoch) { fileWork--; renderUpdateStatus(); }
    }
  });
  modal.addEventListener("close", () => {
    if (modal.open) return;
    modalRevision++;
    if (sourceUrl) { URL.revokeObjectURL(sourceUrl); sourceUrl = null; }
    ui.action = null;
    ui.importBundle = null; ui.importPlan = null; ui.importRevision = null;
    renderUpdateStatus();
  });
  modal.addEventListener("cancel", event => {
    const form = document.getElementById("invitation-form");
    if (form?.getAttribute("aria-busy") === "true") { event.preventDefault(); formFeedback(form, "正在生成邀请，请稍候。"); }
  });
  invitationGuard.addEventListener("cancel", () => Invitations.clearJoin("none", false));
  window.addEventListener("rent-invitation-change", invitationArrived);
  window.addEventListener("rent-invitations-held-change", renderInvitations);
  window.addEventListener("pagehide", () => {
    document.getElementById("join-form")?.reset();
    document.getElementById("auth-form")?.reset();
  });
  window.addEventListener("pageshow", event => {
    if (event.persisted && document.getElementById("join-form") && !user) renderAuth("请重新打开原邀请，或使用已有账号登录。");
  });
  document.addEventListener("toggle", event => {
    const section = event.target.dataset?.editorSection;
    if (!section || !ui.editor || !main.contains(event.target)) return;
    ui.editor.expandedSections ||= {};
    if (ui.editor.expandedSections[section] === event.target.open) return;
    ui.editor.expandedSections[section] = event.target.open;
  }, true);
  document.addEventListener("keyup", event => {
    const hint = document.getElementById("caps-lock-hint");
    if (hint && auth.contains(event.target)) hint.hidden = !event.getModifierState("CapsLock");
  });
  window.addEventListener("online", () => { retryCount = 0; synchronize(); });
  window.addEventListener("rent-open-notifications", openRequestedNotifications);
  window.addEventListener("rent-native-notification", openRequestedNotifications);
  navigator.serviceWorker?.addEventListener("message", event => {
    if (event.data?.type === "RENT_OPEN_NOTIFICATIONS") openRequestedNotifications();
    if (event.data?.type === "RENT_PUSH_RECEIPT_PENDING" && user) toast("通知回执暂未被主机确认，设备状态可能仍显示“通道接受”，不影响查看站内未读提醒。");
    if (event.data?.type === "RENT_PUSH_PAYLOAD_REJECTED" && user) toast("收到无法核验的设备消息。请在“通知设置”中核对配置，不要信任通知外的未知链接。");
  });
  window.addEventListener("offline", () => {
    online = false; chrome();
    if (user && view !== "wizard" && !modal.open && !hasReviewWork() && !hasUnsavedSettings()) render();
  });
  syncTimer = setInterval(() => {
    if (user && retryCount < 6 && navigator.onLine) synchronize();
  }, desktopClient.enabled ? 10000 : 45000);
  setInterval(() => {
    if (user && online && permitted("admin") && (view === "admin" || updateState.maintenance) &&
        Date.now() - lastUpdateStatusAt >= 4500) {
      refreshUpdateStatus().catch(error => {
        if (!error.network && error.name !== "AbortError") showError(error);
      });
    }
  }, 5000);
  setInterval(() => {
    if (user && online && permitted("admin") && view === "admin" && !modal.open) refreshPairings().catch(showError);
  }, 5000);
  setInterval(() => { if (user) offlineAccess(); }, 10000);
  window.addEventListener("beforeunload", event => {
    if (ui.editorDirty || draftRecovery.hasPending() || modal.open || invitationGuard.open || hasUnsavedSettings() || hasReviewWork() ||
        fileWork > 0 || savingWork > 0 || claimingInvitation) {
      event.preventDefault(); event.returnValue = "";
    }
  });
  updateClient = RentUpdateClient.createController({
    version: CLIENT_VERSION, tabId: CLIENT_ID, getWorkState: updateWorkState,
    saveDraft: saveBeforeUpdate, pause: pauseWorkspace, prepareReload: prepareUpdateReload,
    request: async (path, options) => {
      const wasOnline = online;
      if (!csrf) await restoreSession();
      const response = await json(path, { ...options, body: JSON.stringify(options.body) });
      if (wasOnline !== online && user) chrome();
      return response;
    },
    changed: state => { updateState = state; renderUpdateStatus(); },
    reportError: showError, reload: () => location.reload(),
  });
  initialize().catch(error => {
    if (Invitations.status().phase !== "none") {
      renderAuth(error.message || "暂时无法检查邀请，请稍后重试。");
      return;
    }
    auth.innerHTML = `<div class="card auth-card"><h1>无法打开工作区</h1><p>${html(error.message)}</p>
      <p class="auth-footer">请检查主机连接和磁盘剩余空间，再重新打开。若使用浏览器，请退出无痕模式并使用管理员提供的 HTTPS 地址。</p></div>`;
  });
})();
