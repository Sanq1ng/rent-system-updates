  function schedule() {
    if (!ui.editor) return null;
    const d = ui.editor.data;
    const invalid = [];
    d.openingPayments = [];
    for (const [rowId, entry] of Object.entries(ui.editor.opening)) {
      if (entry.paid === "" || !entry.reason.trim()) continue;
      try { d.openingPayments.push({ rowId, paidCents: Domain.parseMoney(entry.paid), reason: entry.reason.trim() }); }
      catch (error) {
        if (!(error instanceof Domain.MoneyValidationError)) throw error;
        invalid.push({ rowId, message: error.message });
      }
    }
    const result = Business.previewContract(d, ui.editor.changeContractId
      ? { amendment: amendmentContext(ui.editor.changeContractId, ui.editor.effectiveDate) } : {});
    for (const error of invalid) {
      const row = result.rows.find(item => item.id === error.rowId);
      result.errors.push(`${row ? Business.rowTitle(row) : "已有收款"}：${error.message}`);
    }
    return result;
