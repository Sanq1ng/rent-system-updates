  async function readyPushRegistration() {
    const registration = await navigator.serviceWorker.getRegistration();
    if (!registration?.active || !registration.pushManager) throw new Error("后台通知组件尚未准备好，请联网重新打开页面后再试。");
    const channel = new MessageChannel();
    let timer;
    try {
      const info = await new Promise((resolve, reject) => {
        timer = setTimeout(() => reject(new Error("当前后台组件尚未支持设备通知，请保存工作后按新版提示刷新页面。")), 2500);
        channel.port1.onmessage = event => resolve(event.data);
        registration.active.postMessage({ type: "GET_APP_INFO" }, [channel.port2]);
      });
      if (info?.version !== CLIENT_VERSION || info.pushProtocol !== 1) {
        throw new Error("页面和后台通知组件版本不一致，请先保存工作，再按新版提示刷新。");
      }
      return registration;
    } finally {
      clearTimeout(timer);
      channel.port1.close(); channel.port2.close();
    }
  }
