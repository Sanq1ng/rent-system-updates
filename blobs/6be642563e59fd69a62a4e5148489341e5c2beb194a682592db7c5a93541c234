  h1 { font-size: 24px; }
  .page-heading { flex-wrap: wrap; gap: 13px; }
  .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .side-stack { grid-template-columns: minmax(0, 1fr); }
  .review-layout { grid-template-columns: minmax(0, 1fr); }
  .review-queue { position: static; }
  .review-columns { grid-template-columns: minmax(0, 1fr); }
  .steps { padding: 15px; }
