  .dashboard-grid { grid-template-columns: minmax(0, 1fr); }
  .side-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .metrics-grid { gap: 12px; }
  .metric-number { font-size: 23px; }
  .wizard-layout { grid-template-columns: minmax(0, 1fr); }
  .wizard-layout > .side-stack { display: none; }
  .review-layout { grid-template-columns: 193px minmax(0, 1fr); }
  .review-columns { grid-template-columns: minmax(0, 1fr); }
  .review-source { border-left: none; border-top: 1px solid var(--line); }
