.draft-list { display: grid; gap: 12px; }
.draft-row { padding: 17px 20px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.draft-row h3 { font-size: 14px; margin-bottom: 5px; }
.draft-row p { color: #96a2a9; font-size: 11px; }
.search-summary { padding: 14px 18px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #dce8e2; border-radius: 9px; background: #f1f8f4; color: #739185; font-size: 12px; }
.nowrap { white-space: nowrap; }
@keyframes spin { to { transform: rotate(360deg); } }
