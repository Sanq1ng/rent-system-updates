  .review-layout { grid-template-columns: 275px minmax(0, 1fr); }
  .review-data { padding: 28px; }
  .source-paper { font-size: 12px; padding: 32px; }
  .metric { padding: 25px; }
  td { padding-top: 21px; padding-bottom: 21px; }
}
