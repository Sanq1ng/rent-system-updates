:root {
  color-scheme: light;
  --bg: #f4f6f8;
  --surface: #fff;
  --text: #253746;
  --muted: #687989;
  --faint: #98a5b0;
  --line: #e6ebef;
  --primary: #197b70;
  --primary-dark: #105d55;
  --primary-soft: #eaf5f1;
  --nav: #152d3b;
  --amber: #a86710;
  --amber-soft: #fff5e5;
  --red: #b84e48;
  --red-soft: #fff0ec;
  --blue: #477ba1;
  --blue-soft: #edf4fb;
  --shadow: 0 4px 20px #203e5010;
  --radius: 15px;
  --sidebar-width: 212px;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.65 "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", system-ui, sans-serif; }
button, input, select, textarea { font: inherit; }
button, select, input[type="checkbox"] { cursor: pointer; }
button { color: inherit; }
button { transition: background .15s ease, box-shadow .15s ease, transform .15s ease; }
button:disabled { cursor: not-allowed; opacity: .48; }
button:not(:disabled):active { transform: translateY(1px); }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid #74bdb2; outline-offset: 3px; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, h4, p { margin: 0; }
h1 { font-size: 28px; line-height: 1.4; letter-spacing: -.6px; }
h2 { font-size: 19px; font-weight: 700; }
h3 { font-size: 16px; font-weight: 700; }
small { font-size: 12px; }
strong { font-weight: 600; }
[hidden] { display: none !important; }
.icon-definitions { position: absolute; width: 0; height: 0; overflow: hidden; }
.icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; vertical-align: middle; }
.app-shell { min-height: 100vh; }
.sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; inset: 0 auto 0 0; background: linear-gradient(165deg, #193947 0%, var(--nav) 55%, #122833 100%); color: #d8e1e5; padding: 30px 16px 18px; display: flex; flex-direction: column; z-index: 30; }
.brand { display: flex; gap: 11px; align-items: center; padding: 0 9px; margin-bottom: 39px; }
.brand-mark { width: 40px; height: 44px; border-radius: 12px; background: linear-gradient(145deg, #66b2a1, #218b7f); display: grid; place-items: center; color: #fff; box-shadow: 0 4px 15px #061e2b3b; }
.brand-mark .icon { width: 27px; height: 27px; }
.brand strong { display: block; font-size: 21px; color: #fff; letter-spacing: 1px; line-height: 1.5; }
.brand small { color: #a5bdc3; font-size: 10px; letter-spacing: 1px; display: block; }
.workspace-label { color: #7e9aa6; font-size: 11px; letter-spacing: 1px; padding: 0 14px 13px; }
.nav-list { display: grid; gap: 7px; }
.nav-item { display: flex; align-items: center; gap: 12px; width: 100%; border: 0; border-radius: 10px; background: transparent; color: #b9ccd3; padding: 13px 14px; text-align: left; position: relative; }
.nav-item:hover { background: #ffffff0a; color: #fff; }
.nav-item.active { color: #fff; background: linear-gradient(100deg, #37736582, #4e8e7b33); box-shadow: inset 0 0 0 1px #7eb29c28; }
.nav-item.active::before { position: absolute; content: ""; left: 0; top: 17px; bottom: 17px; width: 3px; border-radius: 3px; background: #90d6ba; }
.nav-item.active .icon { color: #a5dfc8; }
.nav-count { margin-left: auto; min-width: 21px; height: 21px; line-height: 21px; border-radius: 6px; text-align: center; color: #d7e7e7; background: #ffffff13; font-size: 11px; }
.sidebar-note { margin: 34px 7px 20px; border-top: 1px solid #ffffff12; padding: 23px 9px 0; }
.sidebar-note > .icon { color: #85b9a7; margin-bottom: 10px; }
.sidebar-note strong { display: block; font-size: 12px; color: #c2d9d9; margin-bottom: 6px; }
.sidebar-note p { color: #819daa; font-size: 11px; line-height: 1.9; }
.sidebar-bottom { margin-top: auto; padding-top: 30px; }
.sidebar-link { display: flex; gap: 10px; align-items: center; padding: 9px 15px; width: 100%; background: none; border: 0; color: #9fb6c0; text-align: left; font-size: 12px; }
.sidebar-link:hover { color: #fff; }
.sidebar-link .icon { width: 17px; height: 17px; }
.prototype-version { margin: 17px 12px 0; color: #7894a0; font-size: 10px; white-space: nowrap; display: flex; align-items: center; gap: 7px; }
.status-dot { width: 6px; height: 6px; background: #6bab91; border-radius: 50%; flex: 0 0 6px; }
.workspace { margin-left: var(--sidebar-width); min-height: 100vh; }
.topbar { height: 78px; background: #ffffffed; border-bottom: 1px solid var(--line); padding: 0 30px; display: flex; align-items: center; justify-content: space-between; gap: 16px; position: sticky; top: 0; z-index: 20; backdrop-filter: blur(10px); }
.breadcrumb { display: flex; align-items: center; gap: 11px; white-space: nowrap; font-size: 13px; }
.breadcrumb > span { color: var(--muted); }
.breadcrumb .icon { width: 12px; height: 12px; color: #a9b4bc; }
.topbar-tools { display: flex; align-items: center; gap: 17px; }
.global-search { display: flex; align-items: center; gap: 8px; color: #92a0aa; width: 232px; border-radius: 8px; padding: 8px 10px; background: #f6f8fa; border: 1px solid #edf0f3; }
.global-search .icon { width: 16px; height: 16px; }
.global-search input { min-width: 0; width: 100%; border: none; background: none; font-size: 12px; color: var(--text); outline: none; }
.global-search input::placeholder { color: #92a0aa; }
.icon-button { background: none; border: 1px solid transparent; border-radius: 8px; width: 35px; height: 35px; display: inline-flex; align-items: center; justify-content: center; color: var(--muted); flex-shrink: 0; }
.icon-button:hover { background: #edf2f4; color: var(--text); }
.notification-button { position: relative; }
.notification-dot { width: 5px; height: 5px; border-radius: 50%; background: #d69463; position: absolute; right: 8px; top: 5px; }
.connection-button { display: flex; align-items: center; gap: 5px; color: var(--primary); background: none; border: none; padding: 7px 0; font-size: 11px; white-space: nowrap; }
.connection-button .icon { width: 16px; height: 16px; }
.connection-button.offline { color: var(--amber); }
.role-control { border-left: 1px solid var(--line); padding-left: 17px; display: flex; align-items: center; gap: 9px; }
.avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; color: #397b70; background: #e9f3ed; font-size: 14px; font-weight: 600; flex-shrink: 0; }
.role-control small { display: block; font-size: 10px; line-height: 1.25; color: #85939d; padding-left: 3px; }
.role-control select { border: 0; padding: 2px 15px 0 0; background: transparent; font-size: 12px; color: var(--text); max-width: 156px; }
.prototype-ribbon { min-height: 37px; padding: 6px 30px; background: #eef4f3; border-bottom: 1px solid #dfe9e6; font-size: 11px; color: #607f78; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.prototype-ribbon > span { display: flex; align-items: center; gap: 8px; }
.prototype-ribbon .icon { width: 14px; height: 14px; }
.prototype-ribbon strong { border-right: 1px solid #cbdcd6; padding-right: 8px; white-space: nowrap; }
.prototype-ribbon .text-button { font-size: 11px; white-space: nowrap; }
main { padding: 30px; outline: none; }
.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
.page-heading p { margin-top: 7px; color: var(--muted); font-size: 13px; }
.eyebrow { font-size: 10px; color: var(--primary); letter-spacing: 1.7px; font-weight: 600; text-transform: uppercase; margin-bottom: 5px; }
.heading-actions { display: flex; gap: 9px; align-items: center; flex-shrink: 0; padding-top: 5px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 17px; min-height: 41px; border: 1px solid #dfe6e9; border-radius: 9px; background: #fff; font-size: 13px; font-weight: 500; white-space: nowrap; }
.button:hover { background: #f8fafb; border-color: #c8d6dc; }
.button.primary { background: var(--primary); border-color: var(--primary); color: white; box-shadow: 0 3px 8px #1b796b17; }
.button.primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
.button.soft { background: var(--primary-soft); border-color: #dcebe5; color: var(--primary-dark); }
.button.danger { border-color: #f1d8d2; color: var(--red); background: #fffafa; }
.button.small { min-height: 32px; padding: 6px 12px; font-size: 12px; }
.button .icon { width: 17px; height: 17px; }
.text-button { border: none; background: none; color: var(--primary); display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 3px 0; font-size: 12px; text-align: left; }
.text-button:hover { color: var(--primary-dark); text-decoration: underline; }
.text-button .icon { width: 15px; height: 15px; }
.button-row { display: flex; gap: 9px; align-items: center; flex-wrap: wrap; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.card-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 21px 23px 17px; }
.card-header p { font-size: 12px; color: var(--muted); margin-top: 3px; }
.card-body { padding: 0 23px 23px; }
.metrics-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; margin-bottom: 24px; }
.metric { padding: 20px; position: relative; overflow: hidden; }
.metric-link { display: block; width: 100%; text-align: left; }
.metric-link:hover { border-color: #b6d2c6; box-shadow: 0 7px 24px #203e501a; background: #fcfefd; }
.metric-label { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--muted); gap: 6px; }
.metric-icon { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 9px; background: #eef4f6; color: #628995; }
.metric-icon.green { color: #388975; background: #edf6ef; }
.metric-icon.orange { color: #bc8a4e; background: #fcf2e8; }
.metric-icon.blue { color: #6285b3; background: #edf3fc; }
.metric-icon .icon { width: 18px; height: 18px; }
.metric-number { display: block; font-size: 29px; font-weight: 650; letter-spacing: -.5px; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; font-variant-numeric: tabular-nums; color: #2a414a; margin: 7px 0 3px; line-height: 1.6; }
.metric-number .currency-symbol { font-size: 17px; color: #7a8a90; margin-right: 5px; font-weight: 400; }
.metric-foot { display: flex; align-items: center; justify-content: space-between; gap: 6px; color: #87959d; font-size: 10px; min-height: 17px; }
.metric-foot > .icon { width: 14px; height: 14px; color: #689a89; }
.metric-foot .accent { color: var(--primary); }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 22px; align-items: start; }
.side-stack { display: grid; gap: 20px; }
.segmented { display: inline-flex; gap: 4px; border-radius: 8px; padding: 3px; background: #f1f4f6; flex-wrap: wrap; }
.segmented button { background: none; border: 0; padding: 6px 13px; border-radius: 6px; font-size: 11px; color: var(--muted); }
.segmented button.active { background: white; color: var(--primary-dark); box-shadow: 0 1px 5px #223e4b12; font-weight: 600; }
.collection-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0 23px 17px; gap: 12px; }
.compact-total { color: var(--muted); font-size: 11px; white-space: nowrap; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; }
th { color: #81909a; background: #f9fafb; font-size: 11px; font-weight: 400; padding: 10px 19px; border-top: 1px solid #eef1f3; border-bottom: 1px solid #eef1f3; white-space: nowrap; }
td { border-bottom: 1px solid #eff2f4; padding: 16px 19px; font-size: 12px; vertical-align: middle; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: #fbfdfc; }
.table-primary { display: flex; gap: 11px; align-items: center; min-width: 145px; }
.tenant-link { border: 0; background: none; padding: 0; text-align: left; border-radius: 6px; }
.tenant-link:hover .cell-main { color: var(--primary); text-decoration: underline; }
.tenant-icon { width: 35px; height: 38px; background: #eff3f6; color: #738c98; border-radius: 9px; display: grid; place-items: center; font-size: 13px; flex-shrink: 0; }
.tenant-icon.tint-1 { background: #ecf4f0; color: #6a9983; }
.tenant-icon.tint-2 { background: #f2eff6; color: #9b88a7; }
.tenant-icon.tint-3 { background: #f9f1e9; color: #b19273; }
.cell-main { display: block; font-size: 12px; font-weight: 500; color: #334b55; line-height: 1.7; }
.cell-sub { display: block; font-size: 10px; color: #92a0a8; margin-top: 3px; line-height: 1.6; }
.numeric { font-family: "Segoe UI", "Microsoft YaHei", sans-serif; font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
.amount-due { color: #a7753b; }
.amount-paid { color: var(--primary); }
.badge { display: inline-flex; align-items: center; gap: 5px; border-radius: 5px; padding: 2px 7px; font-size: 10px; white-space: nowrap; font-weight: 400; line-height: 1.8; }
.badge.green { background: #eaf5ed; color: #4b8765; }
.badge.amber { background: var(--amber-soft); color: #ad8139; }
.badge.red { background: #fbefec; color: #bd7366; }
.badge.blue { background: #edf3fa; color: #668cb2; }
.badge.gray { background: #f1f4f6; color: #7c8d98; }
.badge .icon { width: 12px; height: 12px; }
.row-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.table-footer { border-top: 1px solid var(--line); padding: 14px 23px; display: flex; justify-content: space-between; align-items: center; gap: 12px; color: #96a1a9; font-size: 11px; }
.task-item { padding: 15px 0; border-bottom: 1px solid #edf1f2; display: flex; gap: 11px; align-items: flex-start; }
.task-link { width: 100%; text-align: left; background: none; border-width: 0 0 1px; border-style: solid; border-color: #edf1f2; }
.task-link:hover { background: #f7faf8; }
.task-item:last-child { border-bottom: none; padding-bottom: 0; }
.task-symbol { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: #eef5f3; color: #6a9d8d; flex-shrink: 0; }
.task-symbol.amber { background: #fff5e8; color: #bc9858; }
.task-symbol.blue { background: #eff3fb; color: #7698c3; }
.task-symbol .icon { width: 17px; height: 17px; }
.task-info { flex: 1; min-width: 0; }
.task-info strong { font-size: 12px; display: block; margin-bottom: 3px; }
.task-info p { color: #8b9aa3; font-size: 11px; }
.task-description { display: block; color: #8b9aa3; font-size: 11px; }
.task-info .text-button { margin-top: 7px; font-size: 11px; }
.progress-ring { --progress: 71%; width: 108px; height: 108px; padding: 0; border: 0; border-radius: 50%; background: conic-gradient(#79a999 var(--progress), #ecf1ee 0); position: relative; display: grid; place-items: center; margin: 3px auto 17px; }
.progress-ring::after { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: #fff; }
.progress-ring > span { position: relative; z-index: 1; text-align: center; }
.progress-ring:hover { box-shadow: 0 0 0 5px #edf5f1; }
.progress-ring strong { font: 600 25px/1.3 "Segoe UI", sans-serif; display: block; color: #3f6658; }
.progress-ring small { font-size: 10px; color: #91a298; }
.progress-legend { display: flex; justify-content: space-between; font-size: 11px; color: #90a099; padding-top: 13px; border-top: 1px solid #edf2ef; }
.progress-legend > button { text-align: left; background: none; border: 0; border-radius: 6px; padding: 4px; margin: -4px; font-size: inherit; color: inherit; }
.progress-legend > button:hover { background: #f1f7f3; }
.progress-legend .icon { width: 12px; height: 12px; color: #7b9e8c; }
.progress-legend strong { color: #50695d; display: block; font-family: "Segoe UI", sans-serif; font-size: 15px; margin-top: 4px; }
.notice { display: flex; align-items: flex-start; gap: 9px; padding: 12px 15px; border: 1px solid #dceae4; border-radius: 9px; background: #f1f8f4; color: #5d7b6d; font-size: 12px; }
.notice .icon { width: 17px; height: 17px; margin-top: 2px; }
.notice.warning { background: #fff9ee; color: #9a763a; border-color: #f2e7d0; }
.notice.danger { background: #fff2ee; color: #a9564c; border-color: #f1d8d1; }
.notice.neutral { background: #f4f7fa; color: #6d8493; border-color: #e3eaf0; }
.network-banner { border-radius: 0; margin: 0; border-width: 0 0 1px; padding: 10px 30px; }
.stack { display: grid; gap: 16px; }
.muted { color: var(--muted); }
.faint { color: var(--faint); }
.empty-state { padding: 42px 25px; text-align: center; color: #83949e; }
.empty-state .icon { width: 34px; height: 34px; color: #9eb7b2; margin-bottom: 12px; }
.empty-state h3 { color: #627e81; margin-bottom: 7px; }
.empty-state p { font-size: 12px; }
.empty-state .button { margin-top: 18px; }
.filters { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 0 23px 18px; }
.filters label { display: flex; gap: 7px; align-items: center; font-size: 12px; color: #7a8a93; }
.filters select, .filters input { padding: 7px 10px; border: 1px solid #dfe6ea; border-radius: 7px; background: #fff; color: var(--text); font-size: 12px; }
.contract-table td { padding-top: 17px; padding-bottom: 17px; }
.tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--line); margin-bottom: 22px; }
.tabs button { border: 0; background: none; padding: 11px 3px; color: #83929b; font-size: 13px; border-bottom: 2px solid transparent; }
.tabs button.active { color: var(--primary); border-color: var(--primary); font-weight: 600; }
.steps { display: flex; align-items: flex-start; gap: 0; padding: 22px 28px; margin-bottom: 23px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
.step { display: flex; align-items: center; gap: 9px; flex: 1; color: #94a0a9; font-size: 12px; }
.step:last-child { flex: 0 1 auto; }
.step::after { content: ""; height: 1px; background: #e4e9ec; flex: 1; margin: 0 16px; min-width: 13px; }
.step:last-child::after { content: none; }
.step-number { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; border: 1px solid #dfe7e9; font-size: 12px; flex-shrink: 0; background: #fafbfc; }
.step-name { white-space: nowrap; }
.step.active { color: var(--primary-dark); font-weight: 600; }
.step.active .step-number { background: var(--primary); color: #fff; border-color: var(--primary); box-shadow: 0 0 0 4px #edf5f1; }
.step.complete { color: #6b9889; }
.step.complete .step-number { background: #edf6f0; color: var(--primary); border-color: #d6e9df; }
.step.complete .step-number .icon { width: 15px; height: 15px; }
.wizard-layout { display: grid; grid-template-columns: minmax(0, 1fr) 255px; gap: 22px; align-items: start; }
.wizard-form-card { min-height: 433px; padding: 28px; }
.section-heading { display: flex; gap: 11px; align-items: flex-start; margin-bottom: 24px; }
.section-symbol { width: 36px; height: 38px; border-radius: 10px; background: #eff6f1; color: #609783; display: grid; place-items: center; }
.section-heading h2 { font-size: 18px; margin-top: 1px; }
.section-heading p { color: #8a99a2; font-size: 12px; margin-top: 4px; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 21px 22px; }
.field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
.field > label, .field > .field-label { font-size: 12px; font-weight: 500; color: #526774; }
.required { color: #bb775d; margin-left: 3px; }
.field input, .field select, .field textarea { width: 100%; border: 1px solid #dce4e8; background: #fff; border-radius: 8px; padding: 10px 12px; color: #344e5b; font-size: 13px; min-height: 42px; transition: border-color .15s; }
.field input:hover, .field select:hover, .field textarea:hover { border-color: #bfcfd4; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: #83b7a7; box-shadow: 0 0 0 3px #eaf4ee; outline: none; }
.field input::placeholder, .field textarea::placeholder { color: #a5afb6; font-size: 12px; }
.field textarea { resize: vertical; min-height: 112px; line-height: 1.9; }
.field small { font-size: 10px; color: #8d9ca5; }
.field.full { grid-column: 1 / -1; }
.input-affix { position: relative; }
.input-affix input { padding-right: 63px; }
.input-affix span { position: absolute; right: 12px; top: 10px; color: #8c9aa3; font-size: 12px; pointer-events: none; }
.inline-radios { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.choice { display: flex; align-items: center; gap: 8px; border: 1px solid #dde6e8; background: #fff; border-radius: 8px; padding: 10px 14px; font-size: 12px; color: #6c818a; }
.choice.selected { border-color: #79ac98; background: #f2f8f4; color: #366a56; }
.choice input { accent-color: var(--primary); margin: 0; }
.subsection { margin-top: 27px; padding-top: 23px; border-top: 1px solid #edf0f2; }
.subsection-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 15px; }
.subsection-heading h3 { font-size: 14px; }
.subsection-heading small { color: #91a0a8; font-size: 10px; margin-left: 7px; }
.location-row { background: #f8fafb; border: 1px solid #e8eef0; border-radius: 10px; padding: 16px; margin-top: 10px; }
.location-row-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
