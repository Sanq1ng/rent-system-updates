  .mini-summary { gap: 8px; padding: 12px; }
  .mini-summary strong { font-size: 14px; }
  .mini-summary small { font-size: 9px; }
  .modal { max-width: calc(100vw - 24px); max-height: calc(100vh - 30px); }
  .modal-body { padding: 20px; }
  .modal-header { padding: 20px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
@media print {
  @page { size: A4 landscape; margin: 16mm; }
  body { background: white; font-size: 10pt; color: #222; }
  body > :not(.print-area) { display: none !important; }
  .print-area { display: block !important; }
  .print-area h1 { font-size: 20pt; margin: 0 0 5mm; }
  .print-area p { margin-bottom: 5mm; }
  .print-area table { border: 1px solid #ccc; }
  .print-area th, .print-area td { padding: 3mm; border: 1px solid #ccc; font-size: 9pt; }
  .print-area .report-summary { padding: 4mm; margin: 0 0 5mm; }
  .print-area .badge { background: none; }
  .print-area .text-button, .print-area .row-actions { display: none; }
  .print-area .tenant-link { cursor: default; }
  .print-area tr { break-inside: avoid; }
}
