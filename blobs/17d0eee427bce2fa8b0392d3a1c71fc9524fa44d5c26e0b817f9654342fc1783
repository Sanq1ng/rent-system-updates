        !data.openingPayments.some((entry, index) => json(entry) !== json(contract.data.openingPayments[index])) &&
        data.openingPayments.length === contract.data.openingPayments.length,
      "已建立的合同起租日、管账起点及期初已收不可由变更重写；请另行提交明确的账务申请。", 409, "CONFLICT");
      requireThat(rows.some(row => row.periodStart === p.effectiveDate) && invoices.some(invoice => invoice.periodStart === p.effectiveDate),
        "生效日必须是原合同和新合同共有的租金期次起点，不得跨越已有期间。", 409, "CONFLICT");
      requireThat(!invoices.some(invoice => invoice.periodStart < p.effectiveDate && invoice.periodEnd >= p.effectiveDate),
        "生效日穿过已有收费期间，请选择期次边界。", 409, "CONFLICT");
      requireThat(!rows.some(row => row.periodStart < p.effectiveDate && row.periodEnd >= p.effectiveDate),
        "生效日穿过新收费期间，请选择期次边界。", 409, "CONFLICT");
      const future = invoices.filter(invoice => invoice.periodStart >= p.effectiveDate);
      requireThat(future.every(invoice => invoice.paidCents === 0 && invoice.openingPaidCents === 0),
        "未来期次已有已收或期初已收，不能自动替换；请先办理明确的退款／调整结算。", 409, "CONFLICT");
      for (const invoice of future) {
        invoice.status = "superseded";
        invoice.version++;
        store.put("invoices", invoice);
      }
      contract.version++;
      contract.data = data;
      contract.versions.push({ version: contract.version, data, at, actor: reviewer.id, reason: app.reason });
      store.put("contracts", contract);
      for (const row of rows.filter(row => row.periodStart >= p.effectiveDate)) store.put("invoices", invoiceFrom(row, contract));
    } else if (kind === "contract-void") {
      requireThat(invoices.every(invoice => invoice.paidCents === 0 &&
        (invoice.amountCents === 0 || invoice.dueDate > today())),
      "合同存在已收或已到期未结应收，不能直接作废；请办理退租并逐期核定结算。", 409, "CONFLICT");
      for (const invoice of invoices) { invoice.version++; invoice.status = "void"; store.put("invoices", invoice); }
      contract.version++;
      contract.status = "void";
      contract.versions.push({ version: contract.version, data: contract.data, at, actor: reviewer.id, reason: app.reason });
      store.put("contracts", contract);
    } else if (kind === "termination") {
      date(p.terminationDate, "退租日期");
      requireThat(p.terminationDate >= contract.data.startDate && p.terminationDate <= contract.data.endDate, "退租日期须在原合同范围内。");
      const affected = invoices.filter(invoice => invoice.periodEnd > p.terminationDate);
      requireThat(Array.isArray(p.adjustments) && p.adjustments.length === affected.length, "退租须为所有跨过退租日或此后结束的期次逐笔填写核定金额和原因（包含零元）。");
      const ids = new Set();
      for (const adjustment of p.adjustments) {
        requireThat(record(adjustment) && !ids.has(adjustment.invoiceId), "退租调整期次不可重复。");
        ids.add(adjustment.invoiceId);
        const invoice = affected.find(item => item.id === adjustment.invoiceId);
        expected(invoice, adjustment.expectedVersion, "退租期次");
        cents(adjustment.amountCents, "退租后核定金额");
        string(adjustment.reason, "退租核定原因");
        requireThat(adjustment.amountCents >= invoice.paidCents, "退租核定金额不能低于已收净额；请先明确办理退款。", 409, "CONFLICT");
        invoice.amountCents = adjustment.amountCents;
        invoice.manual = true;
        invoice.reason = adjustment.reason.trim();
        invoice.version++;
        store.put("invoices", invoice);
      }
      contract.version++;
      contract.status = "terminated";
      contract.terminationDate = p.terminationDate;
      contract.versions.push({ version: contract.version, data: contract.data, at, actor: reviewer.id, reason: app.reason });
      store.put("contracts", contract);
    } else {
      requireThat(Business.feeKinds.includes(string(p.kind, "期初欠款类别", 80)), "请选择有效的费用类别。");
      string(p.label, "期初欠款名称", 120);
      cents(p.amountCents, "期初欠款金额");
      date(p.periodStart, "欠款所属期起日");
      date(p.periodEnd, "欠款所属期止日");
      date(p.dueDate, "欠款到期日");
      requireThat(p.periodStart <= p.periodEnd && p.periodEnd < contract.data.managementStartDate, "期初欠款只用于管账前结束的历史期间，须人工核定后审批。");
      const originalData = contract.versions[0].data;
      const invoice = { id: uuid(), rowId: `opening:${uuid()}`, version: 1, contractId: contract.id,
        kind: p.kind.trim(), label: p.label.trim(), tenant: contract.data.tenant, locations: contract.data.locations,
        rentTaxMode: originalData.rentTaxMode, lessorId: originalData.lessorId,
        lessorOtherName: originalData.lessorOtherName,
        propertyOwner: originalData.propertyOwner,
        periodStart: p.periodStart, periodEnd: p.periodEnd, dueDate: p.dueDate, amountCents: p.amountCents,
        openingPaidCents: 0, paidCents: 0, status: "active", manual: true, reason: app.reason, flags: ["人工期初欠款"] };
      store.put("invoices", invoice);
      contract.version++;
      contract.versions.push({ version: contract.version, data: contract.data, at, actor: reviewer.id, reason: app.reason });
      store.put("contracts", contract);
    }
  } else {
    const payment = kind === "payment-void" ? store.read("payments", p.paymentId) : null;
    if (kind === "payment-void") expected(payment, p.expectedVersion, "收款");
    const invoice = store.read("invoices", payment?.invoiceId || p.invoiceId);
    requireThat(invoice && invoice.status === "active", "应收期次已变更或作废，请重新同步。", 409, "CONFLICT");
    if (kind !== "payment-void") expected(invoice, p.expectedVersion, "应收期次");
    if (kind === "payment") {
      cents(p.amountCents, "到账金额", true);
      date(p.payDate, "实际到账日");
      string(p.method, "收款方式", 120);
      string(p.note, "收款备注", 2000, false);
      const attachments = attachmentsIn(store, p.attachments, app.creator);
      requireThat(invoice.paidCents + p.amountCents <= invoice.amountCents, "本笔收款超过该期剩余应收，请重新核对分配金额。", 409, "CONFLICT");
      store.put("payments", { id: uuid(), version: 1, contractId: invoice.contractId, invoiceId: invoice.id,
        amountCents: p.amountCents, payDate: p.payDate, method: p.method.trim(), note: p.note.trim(),
        attachments, status: "active", approvedBy: reviewer.id, approvedAt: at });
      invoice.paidCents += p.amountCents;
    } else if (kind === "payment-void") {
      requireThat(payment.status === "active", "收款已经作废。", 409, "CONFLICT");
      requireThat(invoice.paidCents >= payment.amountCents, "此笔收款之后已有退款，作废将导致已收为负；请先处理退款结算。", 409, "CONFLICT");
      invoice.paidCents -= payment.amountCents;
      payment.version++;
      payment.status = "void";
      store.put("payments", payment);
    } else if (kind === "refund") {
      cents(p.amountCents, "退款金额", true);
      date(p.refundDate, "实际退款日");
      requireThat(["reopen", "reduce-charge"].includes(p.effect), "退款必须明确选定重新形成应收或同时减少应收。");
      requireThat(invoice.paidCents >= p.amountCents, "退款不能超过该期已收净额。", 409, "CONFLICT");
      const attachments = attachmentsIn(store, p.attachments, app.creator);
      store.put("refunds", { id: uuid(), invoiceId: invoice.id, contractId: invoice.contractId,
        amountCents: p.amountCents, refundDate: p.refundDate, effect: p.effect,
        reason: app.reason, attachments, approvedBy: reviewer.id, approvedAt: at });
      invoice.paidCents -= p.amountCents;
      if (p.effect === "reduce-charge") invoice.amountCents -= p.amountCents;
    } else if (kind === "invoice-adjustment") {
      cents(p.amountCents, "调整后应收金额");
      date(p.dueDate, "调整后到期日");
      requireThat(p.amountCents >= invoice.paidCents, "调整后的应收不能低于已收净额，请先明确办理退款。", 409, "CONFLICT");
      invoice.amountCents = p.amountCents;
      invoice.dueDate = p.dueDate;
      invoice.manual = true;
      invoice.reason = app.reason;
    }
    invoice.version++;
    store.put("invoices", invoice);
    const contract = store.read("contracts", invoice.contractId);
    contract.version++;
    store.put("contracts", contract);
  }
}
