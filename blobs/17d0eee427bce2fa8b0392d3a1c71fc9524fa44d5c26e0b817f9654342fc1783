  if (linkedContractId) requireThat(contract, "原合同不存在，不能沿用其附件。", 404, "NOT_FOUND");
  const archived = new Set(contract ? [
    ...contract.data.attachments.map(attachment => attachment.id),
    ...contract.versions.flatMap(version => version.data.attachments.map(attachment => attachment.id)),
  ] : []);
  return items.map(item => {
    requireThat(record(item) && typeof item.id === "string", "附件标识无效。");
    const actual = db.prepare("SELECT * FROM attachments WHERE id=?").get(item.id);
    requireThat(actual && (actual.owner === owner || archived.has(item.id)) &&
      attachmentVisible(store, store.read("users", owner), item.id),
    "附件必须先由当前录入者上传，或来自其仍有权查看的已归档业务。", 403, "FORBIDDEN");
    requireThat(item.sha256 === undefined || item.sha256 === actual.sha256, "附件校验值与原件不符。", 409, "CONFLICT");
