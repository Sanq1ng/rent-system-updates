    let app;
    if (operation.type === "submit") {
      requireRole(current, "operator");
      const request = operation.payload;
      string(request.reason, "申请原因", 2000);
      const safePayload = validateSubmission(store, current, request.kind, request.payload);
      const at = now();
      const id = uuid();
      app = { id, number: `SQ-${at.slice(0, 10).replaceAll("-", "")}-${id.slice(0, 8)}`,
        kind: request.kind, status: "pending", version: 1, creator: current.id,
        submittedAt: at, payload: safePayload, reason: request.reason.trim(),
        trail: [], versions: [{ version: 1, payload: safePayload, at }] };
      appendTrail(store, app, "application.submit", current.id, app.number, undefined, { kind: app.kind, payload: app.payload }, operation.clientTime);
    } else if (operation.type === "resubmit") {
      requireRole(current, "operator");
      const request = operation.payload;
      app = store.read("applications", request.applicationId);
      expected(app, request.expectedVersion, "申请");
      requireThat(app.creator === current.id && app.status === "returned", "只有申请人本人可以修改已退回申请。", 403, "FORBIDDEN");
      requireScope(current, scopeForApplication(store, app));
      string(request.reason, "重新提交原因", 2000);
      const safePayload = validateSubmission(store, current, app.kind, request.payload);
      const previous = app.payload;
      app.version++;
      app.status = "pending";
      app.payload = safePayload;
      app.reason = request.reason.trim();
      app.submittedAt = now();
      app.versions.push({ version: app.version, payload: safePayload, at: app.submittedAt });
      appendTrail(store, app, "application.resubmit", current.id, app.number, previous, app.payload, operation.clientTime);
    } else {
      requireRole(current, "reviewer");
      const request = operation.payload;
      app = store.read("applications", request.applicationId);
      expected(app, request.expectedVersion, "申请");
      requireThat(app.status === "pending", "该申请已处理，不能重复审批。", 409, "CONFLICT");
      requireThat(app.creator !== current.id, "不能复核本人提交的申请，即使兼任其他岗位。", 403, "FORBIDDEN");
      requireThat(["approve", "return"].includes(request.decision), "请选择批准或退回。");
      string(request.reason, "审批意见", 2000, request.decision === "return");
      requireScope(current, scopeForApplication(store, app));
      if (request.decision === "approve") {
        const creator = store.read("users", app.creator);
        requireThat(creator?.active && creator.roles.includes("operator") &&
          canSee(creator, scopeForApplication(store, app)),
        "申请人的权限或园区范围已发生变化，须由有权人员重新提交。", 409, "CONFLICT");
      }
      const beforeLedger = request.decision === "approve" ? ledgerState(store, app) : undefined;
      const createdContractId = request.decision === "approve" ? processApproved(store, app, current) : undefined;
      const afterLedger = request.decision === "approve" ? ledgerState(store, app, createdContractId) : undefined;
      app.version++;
      app.status = request.decision === "approve" ? "approved" : "returned";
      app.reviewer = current.id;
      app.reviewedAt = now();
      app.reviewReason = (request.reason || "").trim();
      appendTrail(store, app, `application.${request.decision}`, current.id, app.number,
        { status: "pending", version: request.expectedVersion, ledger: beforeLedger },
        { status: app.status, version: app.version, reason: app.reviewReason, ledger: afterLedger }, operation.clientTime);
    }
    store.put("applications", app);
    const result = { operationId: operation.operationId, applicationId: app.id, status: app.status, version: app.version };
    db.prepare("INSERT INTO operations(actor,id,digest,result) VALUES(?,?,?,?)").run(current.id, operation.operationId, operationDigest, json(result));
    store.changed();
    return result;
  });
}

function createNotifications(store) {
  const db = store.db;
  const clock = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Shanghai", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date());
  const currentDay = today();
  const settings = JSON.parse(db.prepare("SELECT json FROM settings WHERE id=1").get()?.json || "null");
  if (!settings) return;
  store.transaction(() => {
    const invoices = store.all("invoices").filter(invoice => invoice.status === "active");
    let changed = false;
    for (const invoice of invoices) {
      if (invoice.dueDate > currentDay || (invoice.dueDate === currentDay && clock < settings.dueReminderTime) ||
        invoice.paidCents >= invoice.amountCents) continue;
      const id = `due:${invoice.id}:${invoice.dueDate}`;
      changed = Boolean(db.prepare("INSERT OR IGNORE INTO notifications(id,type,date,invoice_id,month) VALUES(?,'due',?,?,NULL)").run(id, invoice.dueDate, invoice.id).changes) || changed;
    }
    for (const month of new Set(invoices.filter(invoice => invoice.kind === "rent" && invoice.dueDate >= settings.accountingStartDate)
      .map(invoice => invoice.dueDate.slice(0, 7)))) {
      if (month > currentDay.slice(0, 7) || (month === currentDay.slice(0, 7) &&
        (currentDay.endsWith("-01") && clock < settings.monthlyReminderTime))) continue;
      const id = `monthly:${month}`;
      changed = Boolean(db.prepare("INSERT OR IGNORE INTO notifications(id,type,date,invoice_id,month) VALUES(?,'monthly',?,NULL,?)").run(id, `${month}-01`, month).changes) || changed;
    }
    if (changed) store.changed();
  });
}

function notificationsFor(store, user, visibleInvoices) {
  if (!user.receiveReminders || !user.roles.some(role => role !== "admin")) return [];
  const visible = new Map(visibleInvoices.filter(invoice => invoice.status === "active").map(invoice => [invoice.id, invoice]));
  const currentMonth = today().slice(0, 7);
  const entries = store.db.prepare(`SELECT n.*,r.user_id AS read_by FROM notifications n
    LEFT JOIN notification_reads r ON r.id=n.id AND r.user_id=? ORDER BY n.date DESC,n.id DESC`).all(user.id);
  const result = entries.flatMap(entry => {
    if (entry.type === "due") {
      const invoice = visible.get(entry.invoice_id);
      if (!invoice || invoice.dueDate !== entry.date || invoice.paidCents >= invoice.amountCents) return [];
      return [{ id: entry.id, type: "due", date: entry.date,
        title: `${invoice.tenant} · ${invoice.label}到期提醒`,
        detail: `应收 ${formatCents(invoice.amountCents)} 元，已收 ${formatCents(invoice.paidCents)} 元，剩余 ${formatCents(invoice.amountCents - invoice.paidCents)} 元。`,
        invoiceId: invoice.id, read: Boolean(entry.read_by) }];
    }
    const month = entry.month;
    if (!month || month > currentMonth) return [];
    const invoices = [...visible.values()].filter(invoice => invoice.kind === "rent" && invoice.dueDate.startsWith(month));
    if (!invoices.length) return [];
    const tenants = new Set(invoices.map(invoice => invoice.tenant.trim().normalize("NFC")));
    const total = invoices.reduce((sum, invoice) => sum + BigInt(invoice.amountCents), 0n);
    const paid = invoices.reduce((sum, invoice) => sum + BigInt(invoice.paidCents), 0n);
    return [{ id: entry.id, type: "monthly", date: entry.date, title: `${month} 收租汇总`,
      detail: `${tenants.size} 户，${invoices.length} 笔租金；应收 ${formatCents(total)} 元，已收 ${formatCents(paid)} 元，未收 ${formatCents(total - paid)} 元。其他费用请另行筛选报表。`,
      month, read: Boolean(entry.read_by) }];
  });
  return result.concat(workflowNotifications(store, user, app => {
    try { return canSee(user, scopeForApplication(store, app)); }
    catch (error) { if (error instanceof ApiError) return false; throw error; }
  }));
}

function snapshot(store, user) {
  const contracts = store.all("contracts").filter(contract => canSee(user, parksOfContract(contract)));
  const ids = new Set(contracts.map(contract => contract.id));
  const invoices = store.all("invoices").filter(invoice => ids.has(invoice.contractId));
  const invoiceIds = new Set(invoices.map(invoice => invoice.id));
  const applications = store.all("applications").filter(app => {
    try { return canSee(user, scopeForApplication(store, app)); }
    catch (error) { if (error instanceof ApiError) return false; throw error; }
  });
  const parks = [...new Set(contracts.flatMap(contract => parksOf(contract.data)))];
  const payments = store.all("payments").filter(payment => invoiceIds.has(payment.invoiceId));
  const refunds = store.all("refunds").filter(refund => invoiceIds.has(refund.invoiceId));
  const history = applications.flatMap(app => app.trail);
  if (user.roles.includes("admin")) history.push(...store.all("audit").filter(entry => entry.action.startsWith("admin.")));
  const actors = new Set([
    ...contracts.flatMap(contract => [contract.approvedBy, ...contract.versions.map(version => version.actor)]),
    ...applications.flatMap(app => [app.creator, app.reviewer, ...app.trail.map(entry => entry.actor)]),
    ...history.map(entry => entry.actor),
    ...payments.map(payment => payment.approvedBy),
    ...refunds.map(refund => refund.approvedBy),
  ]);
  const people = Object.fromEntries([
    ...contracts.map(contract => [contract.data.tenant.trim().normalize("NFC"), { name: contract.data.tenant }]),
    ...store.all("users").filter(actor => actors.has(actor.id))
      .map(actor => [actor.id, { name: actor.displayName }]),
  ]);
  return {
    protocolVersion: 1, serverId: store.serverId, serverTime: now(), today: today(), user: publicUser(user),
    settings: JSON.parse(store.db.prepare("SELECT json FROM settings WHERE id=1").get().json),
    people, parks, parkDirectory: Parks.visibleDirectory(store, user), contracts, invoices, payments, refunds,
    applications, history, notifications: notificationsFor(store, user, invoices),
  };
}

async function readBody(req, limit = 2 * 1024 * 1024) {
  const chunks = [];
  let size = 0;
  for await (const chunk of req) {
    size += chunk.length;
    if (size > limit) fail("提交内容超过大小上限。", 413, "TOO_LARGE");
    chunks.push(chunk);
  }
  try { return JSON.parse(Buffer.concat(chunks).toString("utf8")); }
  catch { fail("请求必须包含有效的 JSON 对象。"); }
}
async function readObject(req, limit) {
  if (limit !== undefined) requireThat(!req.headers["content-length"] ||
    /^\d+$/.test(req.headers["content-length"]) && Number(req.headers["content-length"]) <= limit,
  "提交内容超过大小上限。", 413, "TOO_LARGE");
  const result = await readBody(req, limit);
  requireThat(record(result), "请求内容须为 JSON 对象。");
  return result;
}
function send(res, status, value, extra = {}) {
  res.writeHead(status, { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", ...extra });
  res.end(json(value));
}
function sameOrigin(req, origin) {
  requireThat(req.headers.origin === origin, "请求来源不匹配，操作已拒绝。", 403, "ORIGIN");
}
function socketLocal(req) {
  return ["127.0.0.1", "::1", "::ffff:127.0.0.1"].includes(req.socket.remoteAddress);
}
const assetTypes = {
  ".pdf": "application/pdf", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
  ".webp": "image/webp", ".doc": "application/msword",
  ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
};
function archiveType(name, bytes) {
  const extension = path.extname(name).toLowerCase();
  const mime = assetTypes[extension];
  requireThat(Boolean(mime), "仅支持 PDF、PNG、JPEG、WebP、DOC、DOCX 原始文件。");
  const has = signature => bytes.subarray(0, signature.length).equals(signature);
  const valid = extension === ".pdf" ? has(Buffer.from("%PDF-")) :
    extension === ".png" ? has(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])) :
    [".jpg", ".jpeg"].includes(extension) ? has(Buffer.from([255, 216, 255])) :
    extension === ".webp" ? bytes.toString("ascii", 0, 4) === "RIFF" && bytes.toString("ascii", 8, 12) === "WEBP" :
    extension === ".doc" ? has(Buffer.from([208, 207, 17, 224, 161, 177, 26, 225])) :
    has(Buffer.from([80, 75, 3, 4])) && bytes.includes(Buffer.from("[Content_Types].xml")) && bytes.includes(Buffer.from("word/"));
  requireThat(valid, "文件扩展名与实际文件格式不匹配。");
  return mime;
}
function assetMetadata(row) {
  return { id: row.id, name: row.name, size: row.size, mime: row.mime, sha256: row.sha256 };
}
function attachmentVisible(store, user, id) {
  if (!user?.active || !user.roles.some(role => role !== "admin")) return false;
  const own = Boolean(store.db.prepare("SELECT 1 FROM attachments WHERE id=? AND owner=?").get(id, user.id));
  const owns = items => Array.isArray(items) && items.some(item => item?.id === id);
  const linkedParks = new Set();
  for (const contract of store.all("contracts")) {
    if (owns(contract.data.attachments) || contract.versions.some(version => owns(version.data.attachments))) {
      for (const park of parksOfContract(contract)) linkedParks.add(park);
    }
  }
  for (const app of store.all("applications")) {
    if (app.versions.some(version => owns(version.payload?.data?.attachments) || owns(version.payload?.attachments))) {
      try { for (const park of scopeForApplication(store, app)) linkedParks.add(park); }
      catch (error) { if (!(error instanceof ApiError)) throw error; return false; }
    }
  }
  for (const payment of store.all("payments")) if (owns(payment.attachments)) {
    for (const park of parksOfContract(store.read("contracts", payment.contractId))) linkedParks.add(park);
  }
  for (const refund of store.all("refunds")) if (owns(refund.attachments)) {
    for (const park of parksOfContract(store.read("contracts", refund.contractId))) linkedParks.add(park);
  }
  return linkedParks.size ? canSee(user, [...linkedParks]) : own && user.roles.includes("operator");
}
async function upload(req, store, user, url, reauthenticate) {
  requireRole(user, "operator");
  const name = url.searchParams.get("name");
  requireThat(typeof name === "string" && name.length > 0 && name.length <= 180 &&
    !/[\\/\u0000-\u001f\u007f]/.test(name) && ![".", ".."].includes(name), "原件名称无效或包含路径字符。");
  const uploadId = req.headers["x-upload-id"];
  requireThat(typeof uploadId === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(uploadId),
    "上传标识须为稳定的 UUID。");
  if (req.headers["content-length"] !== undefined) {
    requireThat(Number(req.headers["content-length"]) <= 25 * 1024 * 1024,
      "单个原件不能超过 25 MiB。", 413, "TOO_LARGE");
  }
  const uploadKey = `${user.id}:${uploadId}`;
  requireThat(store.uploads < 4, "同时上传文件过多，请稍后重试。", 429, "RATE_LIMIT");
  requireThat(!store.uploadKeys.has(uploadKey), "相同上传标识正在处理，请等待结果后重试。", 409, "CONFLICT");
  store.uploads++;
  store.uploadKeys.add(uploadKey);
  const assets = path.join(store.db._attachmentsDir);
  const temporary = path.join(assets, `.upload-${uuid()}`);
  const hash = crypto.createHash("sha256");
  let size = 0;
  const guard = new Transform({
    transform(chunk, encoding, callback) {
      size += chunk.length;
      if (size > 25 * 1024 * 1024) callback(new ApiError(413, "TOO_LARGE", "单个原件不能超过 25 MiB。"));
      else { hash.update(chunk); callback(null, chunk); }
    },
  });
  try {
    await pipeline(req, guard, fs.createWriteStream(temporary, { flags: "wx", mode: 0o600 }));
    requireThat(size > 0, "不能上传空文件。");
    const bytes = await fsp.readFile(temporary);
    const mime = archiveType(name, bytes);
    const sha256 = hash.digest("hex");
    const current = reauthenticate();
    requireThat(current?.active && current.roles.includes("operator"), "上传期间账号权限已变化，请重新登录。", 403, "FORBIDDEN");
    const existing = store.db.prepare("SELECT * FROM attachments WHERE owner=? AND upload_id=?").get(user.id, uploadId);
    if (existing) {
      requireThat(existing.sha256 === sha256 && existing.name === name && existing.mime === mime, "上传标识已对应其他文件或名称。", 409, "CONFLICT");
      requireThat(attachmentVisible(store, current, existing.id), "附件的归属园区权限已变化。", 403, "FORBIDDEN");
      return assetMetadata(existing);
    }
    const id = uuid();
    const file = path.join(assets, id);
    requireThat(!fs.existsSync(file), "生成的附件标识已被占用，请重新上传。", 409, "CONFLICT");
    fs.renameSync(temporary, file);
    const handle = fs.openSync(file, "r+");
    try { fs.fsyncSync(handle); } finally { fs.closeSync(handle); }
    try {
      store.transaction(() => {
        const fresh = store.read("users", user.id);
        requireThat(fresh?.active && fresh.roles.includes("operator"), "账号已失去上传权限。", 403, "FORBIDDEN");
        store.db.prepare("INSERT INTO attachments(id,upload_id,owner,name,size,mime,sha256) VALUES(?,?,?,?,?,?,?)")
          .run(id, uploadId, user.id, name, size, mime, sha256);
        store.changed();
      });
    } catch (error) {
      // An unindexed original remains immutable rather than risking deletion after an uncertain write.
      throw error;
    }
    return { id, name, size, mime, sha256 };
  } finally {
    try { if (fs.existsSync(temporary)) fs.unlinkSync(temporary); }
    finally {
      store.uploads--;
      store.uploadKeys.delete(uploadKey);
    }
  }
}

async function startServer(config, { updates = null, bootMaintenance = false, pushTransports, invitationPackageBuilder, pairingConnection } = {}) {
  requireThat(record(config) && typeof config.dataDir === "string" && typeof config.backupDir === "string", "缺少业务数据与备份目录。");
  requireThat(path.isAbsolute(config.dataDir) && path.isAbsolute(config.backupDir) &&
    path.resolve(config.dataDir) !== path.parse(path.resolve(config.dataDir)).root,
  "业务数据与备份目录须为明确的绝对路径，业务数据不可放在磁盘根目录。");
  if (process.platform === "win32") requireThat(!path.resolve(config.dataDir).startsWith("\\\\"),
    "SQLite 业务数据须放在主机本地磁盘，不能放在网络共享目录。");
  const host = config.host || "127.0.0.1";
  const port = config.port ?? 8765;
  requireThat(Number.isInteger(port) && port >= 0 && port < 65536, "监听端口无效。");
  const loopback = ["127.0.0.1", "::1", "localhost"].includes(host);
  requireThat(config.reverseProxy === undefined || typeof config.reverseProxy === "boolean", "reverseProxy 配置无效。");
  const reverseProxy = config.reverseProxy === true;
  if (reverseProxy) {
    requireThat(["127.0.0.1", "::1"].includes(host) && !config.tls && typeof config.publicOrigin === "string",
      "反向代理模式仅允许数字回环监听、固定 HTTPS 来源且不配置后端 TLS。");
    const origin = new URL(config.publicOrigin);
    requireThat(origin.protocol === "https:" && origin.pathname === "/" && !origin.search && !origin.hash &&
      !origin.username && !origin.password, "反向代理模式必须配置固定的完整 HTTPS 来源地址。");
  }
  if (!loopback) requireThat(config.tls && typeof config.publicOrigin === "string" &&
    new URL(config.publicOrigin).protocol === "https:", "非本机访问必须同时配置 HTTPS 证书和公开访问地址。");
  requireThat(!config.tls || typeof config.tls.keyFile === "string" && typeof config.tls.certFile === "string", "TLS 证书设置无效。");
  const lan = validateLan(config.lan, { host, port, tls: config.tls, publicOrigin: config.publicOrigin, reverseProxy });
  const sessionHours = config.sessionHours ?? 8;
  const backupMinutes = config.backupIntervalMinutes ?? 60;
  requireThat(Number.isInteger(sessionHours) && sessionHours >= 1 && sessionHours <= 24 &&
    Number.isInteger(backupMinutes) && backupMinutes >= 0 && backupMinutes <= 10080, "会话或备份间隔设置无效。");
  if (bootMaintenance) requireThat(fs.existsSync(path.join(config.dataDir, "rent.sqlite")),
    "更新启动必须使用已有账本，不会在缺失的数据目录中重新初始化。", 503, "UPDATE_LEDGER_MISSING");
  if (lan) requireThat(fs.existsSync(path.join(config.dataDir, "rent.sqlite")),
    "局域网入口必须使用已初始化的原账本，不会创建新的空账。", 503, "LAN_IDENTITY");
  const pushConfiguration = loadPushCredentials(config);
  const store = openStore(config);
  if (lan && (store.serverId !== lan.serverId || !store.db.prepare("SELECT 1 FROM users LIMIT 1").get())) {
    store.close();
    fail("局域网配置不属于当前已初始化账套；不会在此入口重新注册管理员。", 503, "LAN_IDENTITY");
  }
  store.db._attachmentsDir = path.join(config.dataDir, "attachments");
  store.uploads = 0;
  store.uploadKeys = new Set();
  const initialized = () => Boolean(store.db.prepare("SELECT id FROM users LIMIT 1").get());
  const setupToken = initialized() || reverseProxy ? null : crypto.randomBytes(32).toString("base64url");
  const attempts = new Map();
  const passwordAttempts = new Map();
  const invitations = createInvitationService({ store });
  const desktopNotifications = createDesktopNotifications({ store,
    visibleNotifications: user => snapshot(store, user).notifications });
  const invitationRate = createInvitationRateGate();
  let invitationPackageRunning = false;
  let publicOrigin;
  let push = null, pushHttp = null;
  let pairing = null;
  let backupFailure = store.get("backup_failure") ? JSON.parse(store.get("backup_failure")) : null;
  let reminderFailure = store.get("reminder_failure") ? JSON.parse(store.get("reminder_failure")) : null;
  let lastBackup = null;
  let backupRunning = false;
  let reminderTimer;
  let backupTimer;
  const workspaces = new Workspaces(APPLICATION_VERSION);
  let sealedForUpdate = Boolean(bootMaintenance);
  let updateWindowId = bootMaintenance?.windowId || (bootMaintenance ? uuid() : null);
  let quiescing = false;
  let closing = false;
  let activeBusinessRequests = 0;
  const gateStatus = (admin = false) => {
    const state = workspaces.status(admin);
    if (state.phase === "expired") sealedForUpdate = true;
    return sealedForUpdate && state.phase === "idle"
      ? { phase: "installing", id: updateWindowId, targetVersion: APPLICATION_VERSION, pageCount: 0, readyCount: 0 }
      : state;
  };
  const writeAdmission = () => {
