function audit(store, action, actor, detail, before, after, clientTime) {
  const entry = { id: uuid(), action, actor, at: now(), detail };
  if (clientTime !== undefined) entry.clientTime = clientTime;
  if (before !== undefined) entry.before = before;
  if (after !== undefined) entry.after = after;
  store.db.prepare("INSERT INTO audit(id,action,actor,at,json) VALUES(?,?,?,?,?)").run(entry.id, action, actor, entry.at, json(entry));
  store.changed();
  return entry;
}
