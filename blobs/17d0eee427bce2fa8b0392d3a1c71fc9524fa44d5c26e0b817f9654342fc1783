  const invoiceFor = id => store.read("invoices", id);
  if (kind === "contract") {
    const old = payload.data?.renewalOf ? contractFor(payload.data.renewalOf) : null;
    if (payload.data?.renewalOf) requireThat(old, "续租引用的合同不存在。", 409, "CONFLICT");
    return [...new Set([...parksOf(payload.data), ...parksOfContract(old)])];
  }
  if (["contract-change", "contract-void", "termination", "opening-balance"].includes(kind)) {
    const contract = contractFor(payload.contractId);
    requireThat(contract, "目标合同不存在。", 404, "NOT_FOUND");
    return [...new Set([...parksOfContract(contract), ...(kind === "contract-change" ? parksOf(payload.data) : [])])];
  }
  const invoice = kind === "payment-void"
    ? invoiceFor(store.read("payments", payload.paymentId)?.invoiceId)
    : invoiceFor(payload.invoiceId);
