  const updateControl = route => route === "/api/workspaces/heartbeat" ||
    route === "/api/system/status" || route === "/api/me" ||
    route.startsWith("/api/admin/updates");
  async function quiesceForUpdate({ windowId, targetVersion, deadline, signal }) {
    requireThat(!quiescing && !sealedForUpdate && !closing, "主机已在维护或停止中。", 409, "UPDATE_CONFLICT");
