    internal class WizardForm : Form
    {
        protected new readonly TableLayoutPanel Layout = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, Padding = new Padding(18), AutoScroll = true };
        protected readonly TextBox Output = new TextBox { Multiline = true, ReadOnly = true, ScrollBars = ScrollBars.Vertical, Dock = DockStyle.Fill, BackColor = Color.White, MinimumSize = new Size(100, 120) };
        protected readonly List<Control> Actions = new List<Control>();
        private readonly Label operation = new Label { Name = "operationProgress", AutoSize = true, Visible = false,
            ForeColor = Color.FromArgb(25, 123, 112), MaximumSize = new Size(700, 0) };
        private readonly Timer progressTimer = new Timer { Interval = 1000 };
        private DateTime phaseBegan;
        private string progressText;
        protected bool Busy;
        internal WizardForm(string title)
        {
            Text = title; Font = new Font("Microsoft YaHei UI", 10); AutoScaleMode = AutoScaleMode.Dpi;
            StartPosition = FormStartPosition.CenterScreen; Size = new Size(960, 860); MinimumSize = new Size(790, 700);
            BackColor = Color.FromArgb(246, 249, 250); Controls.Add(Layout);
            FormClosing += (sender, args) => { if (Busy) { args.Cancel = true; MessageBox.Show(this, "正在处理，请先完成或取消 Windows 提示。", "请稍候"); } };
            progressTimer.Tick += (sender, args) => UpdateProgressText();
        }
        protected void Row(Control control, bool fill)
        {
            if (control == Output) Row(operation, false);
            int row = Layout.RowCount++; Layout.RowStyles.Add(fill ? new RowStyle(SizeType.Percent, 100) : new RowStyle(SizeType.AutoSize));
            control.Margin = new Padding(0, 0, 0, 9); Layout.Controls.Add(control, 0, row);
            if (!fill) control.Dock = DockStyle.Top;
        }
        protected Label LabelText(string text, bool heading)
        {
            return new Label { Text = text, AutoSize = true, MaximumSize = new Size(850, 0),
                Font = new Font(Font.FontFamily, heading ? 16 : 10, heading ? FontStyle.Bold : FontStyle.Regular) };
        }
        protected Button Button(string text, EventHandler handler, bool action)
        {
            var button = new Button { Text = text, AutoSize = true, Padding = new Padding(9, 5, 9, 5), Margin = new Padding(0, 0, 8, 5) };
            button.Click += handler; if (action) Actions.Add(button);
            return button;
        }
        protected FlowLayoutPanel Buttons(params Control[] controls)
        {
            var panel = new FlowLayoutPanel { AutoSize = true, WrapContents = true };
            panel.Controls.AddRange(controls); return panel;
        }
        protected async Task Run(Func<string> action)
        {
            if (Busy) return;
            Busy = true; foreach (Control control in Actions) control.Enabled = false; UseWaitCursor = true;
            UpdateButtons();
            operation.Visible = true; progressText = null; ReportProgress("正在处理……"); progressTimer.Start();
            Output.ForeColor = SystemColors.WindowText;
            try { Output.Text = await Task.Run(action); }
            catch (Exception error) { Output.ForeColor = Color.FromArgb(184, 78, 72); Output.Text = error.Message; }
            finally
            {
                progressTimer.Stop(); operation.Visible = false;
                Busy = false; UseWaitCursor = false; foreach (Control control in Actions) control.Enabled = true; UpdateButtons();
            }
        }
        private void UpdateProgressText()
        {
            int seconds = Math.Max(0, (int)(DateTime.UtcNow - phaseBegan).TotalSeconds);
            operation.Text = progressText + (seconds < 5 ? "" : "（已等待 " + seconds + " 秒）");
        }
        protected void ReportProgress(string message)
        {
            if (InvokeRequired) { Invoke((MethodInvoker)(() => ReportProgress(message))); return; }
            if (progressText == message) return;
            progressText = message; phaseBegan = DateTime.UtcNow;
            UpdateProgressText(); Output.Text = message; Output.Refresh();
        }
        protected void ConfirmOnUi(Action action)
        {
            if (InvokeRequired)
            {
                try { Invoke((MethodInvoker)(() => ConfirmOnUi(action))); }
                catch (TargetInvocationException error)
                {
                    if (error.InnerException != null) ExceptionDispatchInfo.Capture(error.InnerException).Throw();
                    throw;
                }
                return;
            }
            // Windows certificate confirmation needs an active STA window, not the background worker.
            ReportProgress("等待 Windows 确认：请在“安全警告”中选择“是”或“否”。");
            bool waiting = UseWaitCursor; UseWaitCursor = false;
            Cursor.Current = Cursors.Default;
            Activate(); BringToFront(); operation.Refresh();
            try { action(); }
            finally { UseWaitCursor = waiting; }
        }
        protected override void Dispose(bool disposing)
        {
            if (disposing) progressTimer.Dispose();
            base.Dispose(disposing);
        }
        protected virtual void UpdateButtons() { }
        protected static string Desktop()
        {
            return Paths.Absolute(Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory, Environment.SpecialFolderOption.DoNotVerify), false);
        }
    }

