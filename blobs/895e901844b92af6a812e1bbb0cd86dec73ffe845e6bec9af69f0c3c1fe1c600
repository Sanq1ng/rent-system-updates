            disable = Button(beginner ? "关闭同事连接" : "停用并恢复原本机配置", async (sender, args) => await Disable(), true);
            open = Button("打开员工接入文件夹", (sender, args) => {
                try
                {
                    if (state == null || !state.shareReady) throw new IOException("尚未完成接入目录。");
                    using (var pins = new DirectoryPins(state.shareDirectory))
                        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(
                            Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Windows), "explorer.exe"),
