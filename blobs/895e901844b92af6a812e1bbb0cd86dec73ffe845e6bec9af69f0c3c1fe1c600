            if (beginner) Row(Buttons(start, Button("重新检测", async (sender, args) => await RefreshStatus(), true), disable), false);
            else Row(Buttons(start, disable, Button("只读刷新", async (sender, args) => await RefreshStatus(), true), open), false);
            close = Button("关闭（主机保持停止）", (sender, args) => Close(), false);
            Row(Buttons(close), false);
            completion = LabelText("状态尚未确认；关闭后父窗口不会自动恢复主机。", false);
            Row(completion, false);
            Row(LabelText(beginner ?
                "仅在公司的办公网络使用。" :
