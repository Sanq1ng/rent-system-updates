(function (root, factory) {
  "use strict";
  if (typeof module === "object" && module.exports) {
    module.exports = factory(require("./domain.js"), require("./business.js"), require("./ui.js"));
  } else root.RentContractForm = factory(root.RentDomain, root.RentBusiness, root.RentUI);
})(globalThis, function (Domain, Business, UI) {
  "use strict";

  const { html, money, yuan, button, note, table } = UI;
  const feeNames = Object.freeze({ rent: "租金", property: "物业费", water: "水费", electricity: "电费", deposit: "押金", other: "其他" });
  const validAmount = row => Number.isSafeInteger(row.amountCents) && row.amountCents >= 0 && row.amountCents <= 1_000_000_000_000;
  const needsAdjustment = row => row.issues.length > 0 || !validAmount(row) || !Domain.isISODate(row.dueDate);
  const blankOpening = (entry, choice) => !choice && (!entry || entry.paid === "" && !entry.reason.trim());

  function openingComplete(row, entry) {
    if (!entry || !entry.reason.trim() || entry.reason.length > 1000 || !validAmount(row)) return false;
    try { return Domain.parseMoney(entry.paid) <= row.amountCents; }
    catch (error) {
      if (error instanceof Domain.MoneyValidationError) return false;
      throw error;
    }
  }

  function openingChoice(row, entry, selected) {
    if (selected === "partial") return "partial";
    if (!entry || entry.paid === "") return "";
    let paid;
    try { paid = Domain.parseMoney(entry.paid); }
    catch (error) {
      if (error instanceof Domain.MoneyValidationError) return "partial";
      throw error;
    }
    if (paid === 0) return "none";
    return validAmount(row) && paid === row.amountCents ? "full" : "partial";
  }

  function chooseOpening(row, entry, choice) {
    if (!["", "none", "full", "partial"].includes(choice)) throw new Error("请选择有效的已收情况。");
    if (choice === "full" && needsAdjustment(row)) throw new Error("请先确认这期应交金额和日期，再选择已收齐。");
    const partial = choice === "partial" && openingChoice(row, entry) === "partial" ? entry?.paid || "" : "";
    return { paid: choice === "none" ? "0" : choice === "full" ? yuan(row.amountCents) : partial,
      reason: entry?.reason || "" };
  }

  function applyOpeningBatch(rows, opening, choice, reason, choices = {}) {
    if (!["none", "full"].includes(choice)) throw new Error("请先选择这些费用是尚未收款还是已经收齐。");
    if (typeof reason !== "string" || !reason.trim() || reason.length > 1000) {
      throw new Error("请填写共同的核对依据，例如交接清单或银行收款记录，最多 1000 字。");
    }
    const targets = rows.filter(row => row.needsOpening && blankOpening(opening[row.id], choices[row.id]));
    if (!targets.length) throw new Error("没有全空的待确认项目；已填写的内容不会被批量覆盖。");
    if (targets.some(needsAdjustment)) throw new Error("请先确认金额和缴费日，再批量填写收款情况。");
    const next = structuredClone(opening);
    // 批量操作仍须用户明确选择并提供依据；绝不把“没填”当成“已收零元”。
    for (const row of targets) next[row.id] = { ...chooseOpening(row, null, choice), reason: reason.trim() };
    return { opening: next, count: targets.length };
  }

  function unusedOverrides(data) {
    const calculated = Domain.generateSchedule({
      startDate: data.startDate, endDate: data.endDate, amount: data.amount,
      amountBasis: data.amountBasis, cycleMonths: data.cycleMonths, anchor: data.anchor,
      advanceMonths: data.advanceMonths, dueDay: data.dueDay,
      freeRent: data.freeEnabled ? { startDate: data.freeStart, endDate: data.freeEnd } : null,
      overrides: data.overrides,
    });
    if (!calculated.rows.length) return [];
    const periods = new Set(calculated.rows.map(row => row.periodStart));
    return Object.keys(data.overrides).filter(date => !periods.has(date));
  }

  function render(editor, step, preview, attachmentLink, parkDirectory = []) {
    const data = editor.data;
    const detail = (key, title, body, initiallyOpen = false) => {
      const open = editor.expandedSections?.[key] ?? initiallyOpen;
      return `<details class="form-section" data-editor-section="${html(key)}" ${open ? "open" : ""}>
        <summary>${html(title)}</summary><div class="section-content">${body}</div></details>`;
    };
    const input = (label, key, type = "text", attrs = "") =>
      `<div class="field"><label for="edit-${key}">${html(label)}</label><input id="edit-${key}" data-edit="${key}" type="${type}" value="${html(data[key])}" ${attrs}></div>`;
    const select = (label, key, values, attrs = "") =>
      `<div class="field"><label for="edit-${key}">${html(label)}</label><select id="edit-${key}" data-edit="${key}" ${attrs}>${values.map(([value, text]) =>
        `<option value="${html(value)}" ${String(data[key]) === String(value) ? "selected" : ""}>${html(text)}</option>`).join("")}</select></div>`;
    const arrayInput = (group, index, key, label, type = "text", attrs = "") =>
      `<div class="field"><label for="${group}-${index}-${key}">${html(label)}</label>
        <input id="${group}-${index}-${key}" data-group="${group}" data-index="${index}" data-key="${key}"
          type="${type}" value="${html(data[group][index][key])}" ${attrs}></div>`;

    if (step === 0) return `<h2>先填合同双方，再上传原件</h2><p class="hint">带 * 的是必填项。联系人等补充资料可以稍后再填。</p>
      <div class="form-grid">${input("合同编号 *", "number", "text", "required")}
        ${select("出租方公司 *", "lessorId", [["", "请选择"], ...Object.entries(Business.lessorEntities)], "required")}
        ${data.lessorId === "other" ? input("其他出租方名称 *", "lessorOtherName", "text", 'required maxlength="160"') : ""}
        ${select("承租方类型", "tenantType", [["company", "企业"], ["person", "个人"]])}
        ${input("承租方全称 *", "tenant", "text", "required")}
        <div class="field full"><label for="original-files">上传合同原件 *</label>
          <input id="original-files" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.webp,.doc,.docx" data-files="contract">
          <small>支持文档和图片，每份不超过 25 兆。</small></div></div>
      ${data.attachments.map(file => `<div class="mini-card attachment-row">${attachmentLink(file)}
        ${button("移除", "remove-file", `data-id="${html(file.id)}"`, "small")}</div>`).join("")}
      ${detail("property-owner", "产权主体（选填，与签约公司分开）",
        `<div class="form-grid">${input("产权主体名称", "propertyOwner", "text", 'maxlength="160"')}</div>
         <p class="hint">产权方、签约公司和园区可能不同；不确定时留空，不按公司名称猜园区。</p>`,
        Boolean(data.propertyOwner))}
      ${detail("contacts", "联系人和电话（选填）", `<div class="form-grid">${input("联系人", "contact")}${input("联系电话", "phone", "tel", 'inputmode="tel"')}</div>`,
        Boolean(data.contact || data.phone))}`;

    if (step === 1) return `<h2>填清租期和出租位置</h2>
      <div class="form-grid">${input("租期开始 *", "startDate", "date", "required")}${input("租期结束 *", "endDate", "date", "required")}
        ${input("从哪天开始记账 *", "managementStartDate", "date", "required")}</div>
      <p class="hint">老合同仍填原来的租期；“开始记账”是这套系统接手账目的日期。</p>
      <h3 class="section-title">出租位置 · ${data.locations.length} 处</h3>
      <p class="hint">园区从授权清单选择。厂房编号尚不清楚时，可先填现有厂房名称或位置说明，不编造编号。</p>
      ${data.locations.map((location, index) => {
        const selected = Business.normalizePark(location.park);
        const missing = selected && !parkDirectory.some(entry => entry.name === selected);
        return `<section class="location-editor">
        <div class="form-grid location-main"><div class="field"><label for="locations-${index}-park">园区 *</label>
          <select id="locations-${index}-park" data-group="locations" data-index="${index}" data-key="park" required>
            <option value="" ${!selected ? "selected" : ""}>请选择所在园区</option>
            ${parkDirectory.map(entry => `<option value="${html(entry.name)}" ${entry.name === selected ? "selected" : ""}>${html(entry.name)}${entry.legacy ? "（旧名称，待核对）" : ""}</option>`).join("")}
            ${missing ? `<option value="${html(location.park)}" selected>${html(location.park)}（旧资料，待核对）</option>` : ""}
          </select></div>
          ${arrayInput("locations", index, "building", "厂房编号或名称")}${arrayInput("locations", index, "floor", "楼层")}</div>
        ${missing ? note("已保留草稿中的原位置；提交前请核对所属园区和当前授权，不会自动替换成其他园区。", "warning") : ""}
        ${detail(`location-${index}`, "补充区域、面积或分配租金（选填）", `<div class="form-grid">
          ${arrayInput("locations", index, "zone", "分割区域")}${arrayInput("locations", index, "area", "面积或位置说明")}
          ${arrayInput("locations", index, "allocatedRent", "此处租金（元，仅按位置分配时填）", "text", 'inputmode="decimal"')}</div>
          <p class="hint">不分摊就全部留空；若分摊，每处都要填写，合计须等于合同租金。</p>`,
          Boolean(location.zone || location.area || location.allocatedRent))}
        <div class="location-actions"><span class="hint">楼栋、楼层、区域、位置说明至少填一项。</span>
          ${data.locations.length > 1 ? button("移除这处位置", "remove-location", `data-index="${index}"`, "small") : ""}</div></section>`;
      }).join("")}
      ${button("再加一处位置", "add-location")}`;

    if (step === 2) return `<h2>约定多少钱、什么时候交</h2>
      <div class="form-grid">${input("合同租金（元）*", "amount", "text", 'required inputmode="decimal"')}
        ${select("这笔金额是", "amountBasis", [["month", "一个月的租金"], ["period", "一次缴费的整笔租金"]])}
        ${select("租金是否含税 *", "rentTaxMode", [["", "请选择"], ...Object.entries(Business.rentTaxModes)], "required")}
        ${select("多久交一次", "cycleMonths", [[1, "每月"], [3, "每季度（3 个月）"], [6, "每半年"], [12, "每年"]])}
        ${input("提前几个月交", "advanceMonths", "number", 'required min="0" max="12" step="1"')}
        ${input("交租月份的几号交", "dueDay", "number", 'required min="1" max="31" step="1"')}</div>
      <p class="hint">例如 10—12 月租金在 9 月 20 日交：每季度交一次、提前 1 个月、20 号交。含税选项不改变录入金额。</p>
      ${detail("period-rule", "租期划分方式", select("每期租金对应哪段时间", "anchor", [
        ["anniversary", "从起租日算（如 15 日到下月 14 日）"], ["calendar", "按整月或整季（如 1—3 月、4—6 月）"],
      ]), true)}
      ${detail("free-rent", "免租和备注（没有可跳过）", `<div class="form-grid">
        ${select("是否约定免租", "freeEnabled", [[false, "没有免租"], [true, "有免租"]])}
        ${data.freeEnabled ? `${input("免租开始", "freeStart", "date", "required")}${input("免租结束", "freeEnd", "date", "required")}` : ""}
        <div class="field full"><label for="edit-notes">合同备注</label><textarea id="edit-notes" data-edit="notes">${html(data.notes)}</textarea></div></div>`,
        data.freeEnabled || Boolean(data.notes))}
      ${detail("fees", `押金、物业费等其他费用${data.fees.length ? `（${data.fees.length} 项）` : "（没有可跳过）"}`,
        `${data.fees.map((fee, index) => `<div class="mini-card"><div class="form-grid">
          ${arrayInput("fees", index, "label", "费用名称 *", "text", "required")}
          <div class="field"><label for="fees-${index}-kind">费用类别</label><select id="fees-${index}-kind" data-group="fees" data-index="${index}" data-key="kind">${Object.entries(feeNames).filter(([key]) => key !== "rent").map(([key, text]) =>
            `<option value="${key}" ${fee.kind === key ? "selected" : ""}>${text}</option>`).join("")}</select></div>
          ${arrayInput("fees", index, "amount", fee.frequency === "period" ? "每次应收合计（元）*" : "本次应收金额（元）*", "text", 'required inputmode="decimal"')}
          <div class="field"><label for="fees-${index}-frequency">什么时候收</label><select id="fees-${index}-frequency" data-group="fees" data-index="${index}" data-key="frequency">
            <option value="once" ${fee.frequency === "once" ? "selected" : ""}>只收一次</option><option value="period" ${fee.frequency === "period" ? "selected" : ""}>每次交租一起收</option></select></div>
          ${fee.frequency === "once" ? arrayInput("fees", index, "dueDate", "应交日期 *", "date", "required") : ""}</div>
          ${fee.frequency === "period" ? `<p class="hint">当前每 ${html(data.cycleMonths)} 个月随租金收一次，这里填每次应收的整笔费用，不是月单价。${data.cycleMonths > 1 ? `例如每月 100 元，完整 ${html(data.cycleMonths)} 个月为 ${html(data.cycleMonths * 100)} 元。` : ""}不足整期或费用调价须按合同核定，本系统不会自动换算。</p>` : ""}
          ${button("移除这项费用", "remove-fee", `data-index="${index}"`, "small")}</div>`).join("")}
          ${button("增加费用", "add-fee")}`, data.fees.length > 0)}`;

    return renderPlan(editor, preview, detail);
  }

  function renderPlan(editor, preview, detail) {
    const { rows, errors, retainedOpeningIds = [] } = preview;
    const opening = editor.opening;
    const adjustments = rows.filter(row => row.kind === "rent" &&
      (needsAdjustment(row) || editor.adjustingPeriod === row.periodStart));
    const oldPayments = rows.filter(row => row.needsOpening);
    const missingPayments = oldPayments.filter(row => !openingComplete(row, opening[row.id]));
    const remaining = new Set([...rows.filter(needsAdjustment), ...missingPayments].map(row => row.id)).size;
    const unused = rows.length ? Object.keys(opening).filter(id => !retainedOpeningIds.includes(id) &&
      !rows.some(row => row.id === id && row.needsOpening)) : [];
    const unusedAdjustments = unusedOverrides(editor.data);
    const blankCount = oldPayments.filter(row => blankOpening(opening[row.id], editor.openingChoices?.[row.id])).length;
    const rowMarkup = row => `<tr><td>${html(row.label)}${row.manual ? "<small>已按合同单独调整</small>" : ""}</td>
      <td>${html(row.periodStart)} 至 ${html(row.periodEnd)}</td><td>${html(row.dueDate || "请确认日期")}</td>
      <td><strong>¥ ${money(row.amountCents)}</strong>${row.kind === "rent" ?
        button("调整这期", "edit-period", `data-period="${html(row.periodStart)}"`, "small") : ""}</td></tr>`;
    const heads = ["费用", "对应租期", "应交日期", "应交金额"];
    return `<h2>确认收租计划</h2><p class="hint">正常月份已自动排好，不用逐行填。只补充下方需要确认的项目。</p>
      ${editor.changeContractId ? note("这里只显示生效日起的新计划；此前正式账目保持原样，原期初已收不可在此修改。", "neutral") : ""}
      <div class="plan-summary"><div><span>本次记账范围</span><strong>${html(editor.changeContractId ? editor.effectiveDate || "待确认生效日" : editor.data.managementStartDate)} 起</strong></div>
        <div><span>已生成</span><strong>${rows.length} 笔费用</strong></div>
        <div><span>需要补充确认</span><strong>${remaining} 笔</strong></div></div>
      ${adjustments.length ? `<section class="plan-attention"><h3>这 ${adjustments.length} 期需要单独确认</h3>
        <p class="hint">零头月份、部分免租或特殊缴费日，请按合同填写；系统不猜金额。</p>
        ${adjustments.map(row => {
          const override = editor.data.overrides[row.periodStart] || { amount: "", dueDate: "", reason: "" };
          return `<div class="plan-adjustment" data-adjustment-card="${html(row.periodStart)}"><h4>${html(Business.rowTitle(row))}</h4>
            ${row.issues.length ? `<p class="row-error">${row.issues.map(html).join("；")}</p>` : ""}
            <div class="form-grid"><div class="field"><label>这期应交金额（元）<input data-override="${html(row.periodStart)}" data-key="amount" value="${html(override.amount)}" inputmode="decimal"></label></div>
              <div class="field"><label>应交日期<input data-override="${html(row.periodStart)}" data-key="dueDate" type="date" value="${html(override.dueDate)}"></label></div>
              <div class="field full"><label>依据或原因<input data-override="${html(row.periodStart)}" data-key="reason" value="${html(override.reason)}" placeholder="例如合同约定的首月租金"></label></div></div>
            ${button("应用本期调整", "preview-again", "", "small")}
            ${editor.data.overrides[row.periodStart] ? button("取消单独调整", "clear-period", `data-period="${html(row.periodStart)}"`, "small") : ""}</div>`;
        }).join("")}</section>` : ""}
      ${oldPayments.length ? `<section class="plan-attention"><h3>开始记账前，这些费用已经收了多少？</h3>
        <p class="hint">下面 ${oldPayments.length} 笔在开始记账前就到了缴费日。请核对旧记录；没找到流水不等于没交。</p>
        ${blankCount > 1 ? detail("opening-batch", `有 ${blankCount} 笔情况相同？一起填写`, `<div class="form-grid">
          <div class="field"><label for="opening-batch-choice">这些费用的已收情况</label><select id="opening-batch-choice" data-opening-batch="choice">
            ${[["", "请选择"], ["none", "都还没收到"], ["full", "都已收齐"]].map(([key, text]) =>
              `<option value="${key}" ${editor.openingBatch?.choice === key ? "selected" : ""}>${text}</option>`).join("")}</select></div>
          <div class="field"><label for="opening-batch-reason">共同核对依据</label><input id="opening-batch-reason" data-opening-batch="reason"
            value="${html(editor.openingBatch?.reason || "")}" placeholder="例如交接清单或银行收款记录"></div></div>
          ${button(`填入 ${blankCount} 笔空白项目`, "apply-opening-batch", "", "soft")}
          <p class="hint">只填写完全空白的项目，不覆盖你已经输入的金额或依据。</p>`) : ""}
        ${oldPayments.map(row => {
          const entry = opening[row.id] || { paid: "", reason: "" };
          const choice = openingChoice(row, entry, editor.openingChoices?.[row.id]);
          const body = `<p class="hint">应交 ¥ ${money(row.amountCents)} · 缴费日 ${html(row.dueDate)}</p><div class="form-grid">
            <div class="field"><label>已收情况<select data-opening-choice="${html(row.id)}">${[
              ["", "请选择"], ["none", "还没收到"], ["full", "已经收齐"], ["partial", "只收到一部分"],
            ].map(([key, text]) => `<option value="${key}" ${choice === key ? "selected" : ""}>${text}</option>`).join("")}</select></label></div>
            ${choice === "partial" ? `<div class="field"><label>已经收到的金额（元）<input data-opening="${html(row.id)}" data-key="paid"
              value="${html(entry.paid)}" inputmode="decimal"></label></div>` : ""}
            <div class="field ${choice === "partial" ? "full" : ""}"><label>核对依据<input data-opening="${html(row.id)}" data-key="reason"
              value="${html(entry.reason)}" placeholder="例如收款记录、交接清单"></label></div></div>`;
          return openingComplete(row, entry) ? detail(`opening-${row.id}`,
            `${Business.rowTitle(row)} · 已确认收到 ¥ ${money(Domain.parseMoney(entry.paid))}（点此修改）`, body) :
            `<div class="opening-item" data-opening-card="${html(row.id)}"><h4>${html(Business.rowTitle(row))}</h4>${body}</div>`;
        }).join("")}</section>` : ""}
      ${unused.length ? note(`租期或记账日期已改变，有 ${unused.length} 项旧的收款确认不再适用。`, "warning") +
        button("移除不再适用的收款确认", "clear-unused-opening", "", "small") : ""}
      ${unusedAdjustments.length ? note(`租期划分已改变，这些日期的单期调整不再适用：${unusedAdjustments.join("、")}。`, "warning") +
        button("移除不再适用的单期调整", "clear-unused-overrides", "", "small") : ""}
      ${errors.length ? `<details class="form-section validation-details"><summary>还有 ${errors.length} 项需要核对，查看说明</summary>
        <div class="section-content">${errors.map(error => `<p class="row-error">${html(error)}</p>`).join("")}</div></details>` :
        note("资料已齐全。核对下面的金额和日期后，提交给另一位财务审核。", "success")}
      <section class="plan-preview"><h3>收租计划预览</h3><p class="hint">租金：${html(Business.rentTaxText(editor.data))} · 出租方：${html(Business.lessorText(editor.data))}</p>
        ${rows.length ? table(heads, rows.slice(0, 6).map(rowMarkup)) : note("请先补齐租期和金额，才能生成收租计划。", "warning")}
        ${rows.length > 6 ? detail("all-periods", `展开其余 ${rows.length - 6} 笔费用`, table(heads, rows.slice(6).map(rowMarkup))) : ""}</section>
      ${errors.length ? button("更新确认结果", "preview-again") : ""}`;
  }

  return Object.freeze({ render, openingComplete, openingChoice, chooseOpening, applyOpeningBatch, needsAdjustment, unusedOverrides });
});
