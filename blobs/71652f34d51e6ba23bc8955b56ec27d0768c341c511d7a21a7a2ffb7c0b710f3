        private bool CanChooseHostBackupDirectory()
        {
            string root = Path.GetDirectoryName(state.Root);
            if (String.IsNullOrEmpty(root) || state.Root != Path.Combine(root, "电脑端资料")) return false;
            string roleFile = Path.Combine(root, "配置", "电脑角色.json"), installationFile = Path.Combine(root, "installation.json");
            if (!File.Exists(roleFile) || !File.Exists(installationFile)) return false;
            using (var pins = new DirectoryPins(root)) {
                var role = Json.Object(Product.Utf8.GetString(Paths.Read(roleFile, 2048)));
                var installation = Json.Object(Product.Utf8.GetString(Paths.Read(installationFile, 32768)));
                return Json.String(role, "mode") == "host" &&
                    Json.String(role, "installationId") == Json.String(installation, "installationId") &&
                    Json.String(installation, "ownerSid") == Product.Sid;
            }
        }
        private void ChooseHostBackupDirectory(string requestId)
        {
            if (IsDisposed || Disposing) return;
            if (choosingBackupDirectory) {
                Send(new { protocol = 1, kind = "backup-directory-selected", requestId, failed = true });
                return;
            }
            choosingBackupDirectory = true;
            try {
                if (!CanChooseHostBackupDirectory())
                    throw new IOException("请在保管账本的电脑上选择备份盘，员工电脑不能替主机选择本机文件夹。");
                using (var picker = new FolderBrowserDialog { Description =
                    "选择独立备份硬盘上的文件夹。软件会检查物理盘和权限，不会格式化或覆盖已有备份。", ShowNewFolderButton = true }) {
                    bool selected = picker.ShowDialog(this) == DialogResult.OK;
                    Send(new { protocol = 1, kind = "backup-directory-selected", requestId,
                        cancelled = !selected, directory = selected ? picker.SelectedPath : null });
                }
            } catch (Exception error) {
                Send(new { protocol = 1, kind = "backup-directory-selected", requestId, failed = true });
                NoticeStatus("文件夹选择未完成：" + Program.Safe(error.Message), error);
            } finally { choosingBackupDirectory = false; }
        }
        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            if (!canExit) {
                e.Cancel = true;
                if (e.CloseReason == CloseReason.WindowsShutDown) { var task = ExitSafely(); }
                else { Hide(); SetStatus("软件已收起，后台提醒仍在运行。", null); }
            }
            base.OnFormClosing(e);
        }
        protected override void Dispose(bool disposing)
        {
            if (disposing && !resourcesDisposed) {
                resourcesDisposed = true;
                cancellation.Cancel(); pollTimer.Stop(); pollTimer.Dispose();
                if (pairing != null) pairing.Dispose();
                tray.Visible = false; tray.ContextMenuStrip.Dispose(); tray.Dispose();
                browser.Dispose(); cancellation.Dispose();
            }
            base.Dispose(disposing);
        }
    }
