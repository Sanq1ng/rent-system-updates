.auth-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: linear-gradient(145deg, #152d3b, #22514e); }
.auth-card { width: min(480px, 100%); padding: 34px; }
.auth-card h1 { margin: 0 0 9px; }
.auth-card .form-grid { margin-top: 22px; }
.auth-card .button { width: 100%; }
.auth-card .notice { margin: 16px 0; }
.auth-footer { color: #8699a4; font-size: 12px; margin-top: 17px; }
.network-banner { margin: 14px 30px 0; }
.update-notice { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
.update-notice[hidden] { display: none; }
.update-notice p { margin: 4px 0 0; }
.update-notice .button-row { flex-wrap: wrap; flex-shrink: 0; }
.update-panel .update-description { white-space: pre-wrap; overflow-wrap: anywhere; }
.update-panel .update-details { margin-top: 14px; }
.update-panel .update-details summary { cursor: pointer; color: var(--primary-dark); }
.role-control { max-width: 260px; }
.role-control strong { display: block; font-size: 12px; line-height: 1.2; }
.role-control small { padding: 0; line-height: 1.4; }
.workspace .hint { color: var(--muted); font-size: 12px; }
.workspace .hint + .hint { margin-top: 9px; }
.workspace .top-gap { margin-top: 15px; }
.workspace .section-title { margin: 22px 0 12px; font-size: 16px; }
.workspace .card-pad { padding: 23px; }
.workspace .card-pad + .card-pad { margin-top: 16px; }
.workspace .card-pad > .notice { margin: 12px 0; }
.workspace .card-pad > .button-row { margin-top: 16px; }
.workspace .form-grid { margin: 14px 0; }
.workspace .list-row { padding: 15px 20px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.workspace .list-row > div { min-width: 0; }
.workspace .list-row small { display: block; color: var(--muted); }
.workspace .list-row button { flex-shrink: 0; }
.workspace .stack { display: grid; gap: 14px; }
.workspace .split { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; align-items: start; }
.workspace .compact-fields { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 10px; align-items: end; margin: 12px 0; }
.workspace .compact-fields .field input, .workspace .compact-fields .field select { padding: 7px; }
.workspace .muted { color: var(--muted); }
.workspace .toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 12px 0 20px; }
.workspace .toolbar label { display: flex; align-items: center; gap: 5px; font-size: 12px; }
.workspace .toolbar select, .workspace .toolbar input { border: 1px solid #dce4e8; border-radius: 7px; padding: 8px; max-width: 200px; }
.workspace .row-error { color: var(--red); font-size: 12px; }
.workspace .row-ok { color: var(--primary); font-size: 12px; }
.workspace .table-wrap { overflow: auto; }
.workspace .table-wrap table { min-width: 700px; }
.workspace .table-wrap td, .workspace .table-wrap th { vertical-align: top; }
.workspace .table-wrap td .button { margin: 2px; }
.workspace .wizard-layout { grid-template-columns: minmax(0,1fr) 245px; }
.workspace .wizard-form-card { min-height: 260px; }
.workspace .wizard-footer { bottom: 0; }
.workspace .source-view { min-height: 260px; max-height: 66vh; overflow: auto; background: #eef2f4; border-radius: 9px; border: 1px solid var(--line); }
.workspace .source-view iframe, .workspace .source-view img { width: 100%; min-height: 420px; border: none; object-fit: contain; }
.workspace .mini-card { background: #f7faf9; border: 1px solid var(--line); border-radius: 10px; padding: 13px; margin: 10px 0; }
.workspace .badge { white-space: nowrap; }
.workspace .selection-grid { display: flex; gap: 12px; flex-wrap: wrap; }
.workspace .selection-grid label { display: flex; align-items: center; gap: 4px; }
.workspace .steps { overflow-x: auto; }
.workspace .metric-foot { text-align: left; }
.workspace .empty-state { padding: 35px 22px; }
.workspace .inline-error { margin: 12px 0; }
.workspace .file-choice { display: block; font-size: 12px; margin: 8px 0; }
.workspace .file-choice input { max-width: 100%; }
.modal-body .field { margin: 10px 0; }
.modal-body .source-view { min-height: 300px; }
.modal-body .source-view iframe, .modal-body .source-view img { width: 100%; height: 380px; object-fit: contain; }
.modal-body .split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.modal-body .mini-card { background: #f7faf9; padding: 12px; border-radius: 9px; margin: 9px 0; }
.modal-body .selection-grid label { margin-right: 12px; }
.modal-body input, .modal-body select, .modal-body textarea { max-width: 100%; }
.print-area { display: none; }
@media (max-width: 1050px) {
  .workspace .split, .workspace .wizard-layout { grid-template-columns: 1fr; }
  .workspace .compact-fields { grid-template-columns: repeat(2,minmax(0,1fr)); }
}
@media (max-width: 800px) {
  .workspace .metrics-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .workspace .page-heading { display: block; }
  .workspace .topbar { height: auto; min-height: 65px; flex-wrap: wrap; padding: 8px 16px; }
}
@media print {
  body:has(.print-area:not(:empty)) .app-shell { display: none !important; }
  .sidebar,.topbar,.prototype-ribbon,.network-banner,.page-heading,.toolbar,.heading-actions,.wizard-footer,.modal,.button,.print-hide { display: none !important; }
  .workspace { margin: 0 !important; }
  .print-area:not(:empty) { display: block !important; padding: 12px; }
  main:has(~ .print-area:not(:empty)) { display: none !important; }
  .print-area table { width: 100%; border-collapse: collapse; font-size: 10px; }
  .print-area th,.print-area td { border: 1px solid #aaa; padding: 5px; }
}
[data-invoice-id] td > small { display: block; margin-top: 5px; color: #758995; font-size: 12px; line-height: 1.7; white-space: normal; }
[data-invoice-id] td > .button { margin-top: 6px; }
.toast-container .toast { pointer-events: none; }
.contract-metadata { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 14px 0; padding: 14px 16px; border: 1px solid #dceae4; border-radius: 10px; background: #f1f8f4; }
.contract-metadata dt { margin-bottom: 5px; color: #6c837b; font-size: 12px; }
.contract-metadata dd { margin: 0; color: #23493f; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
[data-contract-id] td > small { display: block; margin-top: 5px; color: #758995; font-size: 12px; line-height: 1.7; }
.workspace .report-details table { min-width: 1450px; }
.workspace .report-details th { white-space: nowrap; }
.workspace .report-details td { min-width: 78px; max-width: 210px; overflow-wrap: anywhere; }
.page-location { display: flex; align-items: center; gap: 14px; min-width: 0; }
#page-back { flex-shrink: 0; color: var(--primary-dark); }
.auth-card { width: min(520px, 100%); }
.auth-card .full { grid-column: 1 / -1; }
.auth-card .form-grid > .button { grid-column: 1 / -1; }
.auth-card .hint { color: var(--muted); font-size: 12px; }
.password-input { display: flex; border: 1px solid #dce4e8; border-radius: 8px; overflow: hidden; }
.password-input input { min-width: 0; border: 0; border-radius: 0; }
.password-toggle { flex-shrink: 0; padding: 0 14px; border: 0; border-left: 1px solid var(--line); background: #f1f8f5; color: var(--primary-dark); cursor: pointer; font-size: 13px; }
.password-toggle:hover { background: var(--primary-soft); }
.form-section { margin: 16px 0; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
.form-section > summary { padding: 13px 16px; cursor: pointer; font-weight: 500; font-size: 13px; color: var(--primary-dark); }
.form-section > summary:hover { background: #f7faf9; border-radius: 10px; }
.section-content { padding: 0 16px 16px; }
.section-content > p + p { margin-top: 10px; }
.section-content > .form-grid { margin-top: 8px; }
.workspace .wizard-form-card, .workspace .steps, .workspace .wizard-footer { max-width: 1120px; margin-left: auto; margin-right: auto; }
.workspace .wizard-form-card { padding: 26px 30px; }
.wizard-form-card > h2 + .hint { margin-top: 8px; }
.wizard-form-card .field > label { font-size: 13px; }
.wizard-form-card .field > label:has(input, select) { display: grid; gap: 7px; }
.workspace .wizard-form-card .form-grid { gap: 18px 24px; margin: 22px 0; }
.workspace .wizard-form-card .location-main { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.location-editor { margin: 14px 0; padding: 0 18px 15px; border: 1px solid var(--line); border-radius: 12px; }
.location-actions, .attachment-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.attachment-row .button { flex-shrink: 0; }
.plan-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 22px 0; }
.plan-summary > div { background: #f1f8f5; border: 1px solid #dceae4; border-radius: 12px; padding: 14px 18px; }
.plan-summary span { display: block; font-size: 12px; color: var(--muted); }
.plan-summary strong { display: block; margin-top: 5px; font-size: 19px; color: var(--primary-dark); }
.plan-attention { padding: 20px; margin: 22px 0; border: 1px solid #e9d8b8; background: #fffdf8; border-radius: 12px; }
.plan-attention > .hint { margin: 7px 0 14px; }
.plan-adjustment, .opening-item { padding: 18px 0; border-top: 1px solid #e9e3d7; }
.plan-adjustment > h4, .opening-item > h4 { margin-bottom: 8px; }
.plan-adjustment .button + .button { margin-left: 8px; }
.plan-preview { margin-top: 24px; }
.plan-preview > .hint { margin: 7px 0 14px; }
.workspace .plan-preview table { min-width: 580px; }
.workspace .plan-preview td { padding: 12px 14px; }
.plan-preview td > small { display: block; margin-top: 4px; color: var(--muted); }
.plan-preview td:last-child { white-space: nowrap; }
.plan-preview td:last-child > .button { margin-left: 10px; }
.validation-details { border-color: #ebd6cc; }
.validation-details > summary { color: var(--amber); }
.technical-note { margin-top: 7px; color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }
.technical-note > summary { cursor: pointer; }
.prototype-ribbon > span { flex-wrap: wrap; }
@media (max-width: 1200px) {
  .workspace .topbar { flex-wrap: wrap; height: auto; min-height: 78px; padding-top: 10px; padding-bottom: 10px; }
  .topbar-tools { flex-wrap: wrap; min-width: 0; }
  .global-search { width: 185px; }
}
@media (max-width: 700px) {
  .workspace .wizard-form-card { padding: 20px; }
  .workspace .wizard-form-card .location-main { grid-template-columns: 1fr; }
  .plan-summary { grid-template-columns: 1fr; gap: 9px; }
  .plan-summary > div { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .plan-summary strong { margin: 0; font-size: 16px; }
  .plan-attention { padding: 14px; }
  .page-location { width: 100%; }
  .workspace .wizard-footer .button-row { flex-wrap: wrap; }
}
