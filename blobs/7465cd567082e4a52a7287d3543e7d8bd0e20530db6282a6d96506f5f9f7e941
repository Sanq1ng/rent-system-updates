            menu.Items.Add(new ToolStripSeparator());
            menu.Items.Add("停止并退出", null, delegate { RequestExit(); });
            tray.ContextMenuStrip = menu;
            tray.DoubleClick += delegate { ShowManager(); };
            tray.BalloonTipClicked += delegate { ShowManager(); };
            tray.Visible = true;
            RefreshControls();
        }

        private void Ui(Action action)
        {
            if (IsDisposed || Disposing || !IsHandleCreated) return;
            try { BeginInvoke(new Action(delegate { if (!IsDisposed && !Disposing) action(); })); }
            catch (InvalidOperationException) { }
        }

        private string Clean(string value, int maximum)
        {
            string text = Regex.Replace(value ?? "", "[\\x00-\\x1f\\x7f]+", " ");
            if (!String.IsNullOrEmpty(setupToken)) text = text.Replace(setupToken, "[口令已隐藏]");
            text = Regex.Replace(text, "[A-Za-z0-9_-]{40,}", "[敏感长串已隐藏]");
            return text.Length <= maximum ? text : text.Substring(0, maximum) + "…";
        }

        private void AddActivity(string text)
        {
            string message = DateTime.Now.ToString("HH:mm:ss") + "  " + Clean(text, 180);
            activity.Enqueue(message);
            while (activity.Count > 3) activity.Dequeue();
            activityLabel.Text = String.Join(Environment.NewLine, activity.ToArray());
            tips.SetToolTip(activityLabel, activityLabel.Text);
        }

        private void SetState(HostState value, string detail)
        {
            state = value;
            string heading;
            Color color;
            switch (value)
            {
                case HostState.Starting: heading = "正在启动主机"; color = Theme.Teal; break;
                case HostState.Running: heading = "主机运行中"; color = Theme.Teal; break;
                case HostState.Stopping: heading = "正在安全停止"; color = Theme.Amber; break;
                case HostState.Blocked: heading = "账本正在使用"; color = Theme.Amber; break;
                case HostState.Unresponsive: heading = "响应超时 · 待确认"; color = Theme.Amber; break;
                case HostState.Error: heading = "主机未就绪"; color = Theme.Red; break;
                default: heading = "主机已停止"; color = Theme.Muted; break;
            }
            stateLabel.Text = "●  " + heading;
            stateLabel.ForeColor = color;
            stateDetail.Text = Clean(detail, 600);
            tips.SetToolTip(stateDetail, stateDetail.Text);
            ownership.Text = value == HostState.Blocked ? "请检查原主机或维护窗口" : "";
            tray.Text = "园区租赁 · " + heading;
            RefreshControls();
        }

        private void RefreshControls()
        {
            bool owned = current != null && current.Ready && !current.ExpectedStop && !current.ReportedError;
            bool usable = !String.IsNullOrEmpty(businessUrl) && (state == HostState.Running || state == HostState.Unresponsive || state == HostState.Blocked);
            openButton.Enabled = usable;
            openButton.Text = state == HostState.Blocked ? "尝试打开业务页  ↗" : "打开业务页面  ↗";
            startButton.Enabled = current == null && !exitAfterStop && !updating && !configuringLan;
            stopButton.Enabled = current != null && !current.ExpectedStop && !current.ReportedError && (owned || state == HostState.Starting);
            restartButton.Enabled = owned && !configuringLan;
            if (lanButton != null) lanButton.Enabled = !configuringLan && !updating && !exitAfterStop &&
                !creatingAccount &&
                state != HostState.Blocked &&
                (current == null || owned && initialized);
            if (setupAccountButton != null) setupAccountButton.Enabled = owned && !initialized && !creatingAccount;
            dataButton.Enabled = !String.IsNullOrEmpty(businessUrl);
            backupButton.Enabled = !String.IsNullOrEmpty(businessUrl);
            if (trayOpen != null) { trayOpen.Enabled = usable; trayStop.Enabled = stopButton.Enabled; trayRestart.Enabled = restartButton.Enabled; }
        }

        private void StartHost()
        {
            if (current != null || exitAfterStop || updating || configuringLan) return;
            ClearToken();
            initialized = false;
            businessUrl = null;
            address.Text = "正在解析实际访问地址…";
            dataPath.Text = backupPath.Text = "等待本次配置解析";
            UpdateSetup();
            SetState(HostState.Starting, "正在检查程序与配置，随后打开账本。请稍候。");
            OwnedJob job = null;
            HostRun run = null;
            Process process = null;
            try
            {
                applicationDirectory = LaunchOptions.FindApplication();
                ReadVersion();
                job = new OwnedJob();
                var info = new ProcessStartInfo {
                    FileName = Path.Combine(applicationDirectory, "runtime", "node.exe"),
                    Arguments = "--disable-warning=ExperimentalWarning " + LaunchOptions.Quote(Path.Combine(applicationDirectory, "host.cjs")) +
                        " --desktop --no-browser" + (options.ConfigFile == null ? "" : " --config " + LaunchOptions.Quote(options.ConfigFile)) +
                        (startupUpdateJob == null ? "" : " --update-job " + LaunchOptions.Quote(startupUpdateJob)),
                    WorkingDirectory = applicationDirectory, UseShellExecute = false, CreateNoWindow = true,
                    RedirectStandardInput = true, RedirectStandardOutput = true, RedirectStandardError = true,
                    StandardOutputEncoding = new UTF8Encoding(false), StandardErrorEncoding = new UTF8Encoding(false)
                };
                info.EnvironmentVariables.Remove("NODE_OPTIONS");
                info.EnvironmentVariables.Remove("NODE_PATH");
                process = new Process { StartInfo = info, EnableRaisingEvents = true };
                run = new HostRun(process, job);
                run.UpdateJobId = startupUpdateJob;
                HostRun captured = run;
                process.OutputDataReceived += delegate(object sender, DataReceivedEventArgs e) {
                    if (e.Data != null) Ui(delegate { Receive(captured, e.Data); });
                };
                process.ErrorDataReceived += delegate(object sender, DataReceivedEventArgs e) {
                    if (e.Data != null) Ui(delegate {
                        if (current != captured) return;
                        captured.LastError = Clean(e.Data, 500);
                        AddActivity("主机提示：" + captured.LastError);
                    });
                };
                process.Exited += delegate {
                    Task.Run(delegate {
                        int code;
                        try { captured.Process.WaitForExit(); code = captured.Process.ExitCode; }
                        catch (InvalidOperationException) { return; }
                        Ui(delegate { HostExited(captured, code); });
                    });
                };
                current = run;
                if (!process.Start()) throw new IOException("无法创建随包主机进程。");
                job.Assign(process);
                process.BeginOutputReadLine();
                process.BeginErrorReadLine();
                run.Send("start", delegate { Ui(delegate { CommunicationLost(captured); }); });
                AddActivity("已启动受托管进程；等待账本与访问端口就绪。");
                RefreshControls();
            }
            catch (Exception error)
            {
                current = null;
                if (job != null) job.Dispose();
                // No start handshake is sent before job assignment succeeds.
                if (process != null)
                {
                    Process failed = process;
                    Task.Run(delegate {
                        try {
                            failed.StandardInput.Close();
                            if (!failed.WaitForExit(5000)) failed.Kill();
                        } catch (InvalidOperationException) { } catch (IOException) { } catch (System.ComponentModel.Win32Exception) { }
                        finally { failed.Dispose(); }
                    });
                }
                SetState(HostState.Error, error.Message);
                AddActivity("启动未完成：" + error.Message);
                if (startupUpdateJob != null && !rollbackAttempted) CoordinateUpdate("rollback", startupUpdateJob);
            }
        }

        private void ReadVersion()
        {
            string file = ActivePackageFile();
            if (new FileInfo(file).Length > 65536) throw new InvalidDataException("程序版本文件异常过大，请恢复完整交付包后启动。");
            var package = json.Deserialize<Dictionary<string, object>>(File.ReadAllText(file, Encoding.UTF8));
            if (package == null) throw new InvalidDataException("程序版本文件格式不正确，尚未打开账本。");
            string version = Value(package, "version");
            if (!Regex.IsMatch(version, "^\\d+\\.\\d+\\.\\d+$"))
                throw new InvalidDataException("程序版本号缺失或格式不正确，请恢复完整交付包后启动。");
            versionLabel.Text = "WINDOWS 主机 · v" + version;
            selectedVersion = version;
        }

        private static string Value(Dictionary<string, object> message, string key)
        {
            object value;
            return message.TryGetValue(key, out value) && value is string ? (string)value : "";
        }

        private void Receive(HostRun run, string line)
        {
            if (current != run || !line.StartsWith(Prefix, StringComparison.Ordinal)) return;
            try
            {
                if (line.Length > 16384) throw new InvalidDataException();
                var message = json.Deserialize<Dictionary<string, object>>(line.Substring(Prefix.Length));
                if (message == null || !message.ContainsKey("protocol") || Convert.ToInt32(message["protocol"]) != 2) throw new InvalidDataException();
                run.LastReply = DateTime.UtcNow;
                string type = Value(message, "type");
                if (type == "starting" || type == "ready")
                {
                    if (!message.ContainsKey("pid") || Convert.ToInt32(message["pid"]) != run.Process.Id) throw new InvalidDataException();
                    Uri origin;
                    string url = Value(message, "url");
                    string data = Value(message, "dataDir"), backup = Value(message, "backupDir");
                    if (!Uri.TryCreate(url, UriKind.Absolute, out origin) || (origin.Scheme != "http" && origin.Scheme != "https") ||
                        origin.UserInfo.Length != 0 || origin.Query.Length != 0 || origin.Fragment.Length != 0 ||
                        !Path.IsPathRooted(data) || !Path.IsPathRooted(backup)) throw new InvalidDataException();
                    businessUrl = url;
                    address.Text = "业务地址  " + url;
                    dataPath.Text = data;
                    backupPath.Text = backup;
                    tips.SetToolTip(dataPath, data);
                    tips.SetToolTip(backupPath, backup);
                    if (type == "ready")
                    {
                        run.Ready = true;
                        CompleteUpdateStart(run);
                        initialized = message.ContainsKey("initialized") && message["initialized"] is bool && (bool)message["initialized"];
                        setupToken = initialized ? null : Value(message, "setupToken");
                        if (!initialized && !Regex.IsMatch(setupToken ?? "", "^[A-Za-z0-9_-]{43}$")) throw new InvalidDataException();
                        MaskToken();
                        if (!run.ExpectedStop)
                        {
                            SetState(HostState.Running, "可以打开业务页面开始工作。");
                            AddActivity("中心主机已就绪；数据由本次配置指定的目录保存。");
                            if (firstBrowser && !options.NoBrowser)
                            {
                                if (!initialized && !options.AdvancedSetup) BeginInvoke((MethodInvoker)OpenAccountSetup);
                                else OpenBusiness(options.BackgroundClient);
                            }
                            firstBrowser = false;
                        }
                        UpdateSetup();
                    }
                    RefreshControls();
                }
                else if (ReceiveUpdate(run, message, type)) { }
                else if (ReceiveAccountSetup(message, type)) { }
                else if (type == "status")
                {
                    if (message.ContainsKey("initialized") && message["initialized"] is bool && (bool)message["initialized"] && !initialized)
                    {
                        initialized = true;
                        ClearToken();
                        UpdateSetup();
                        RefreshControls();
                        AddActivity("管理员账号已创建。");
                    }
                    if (Value(message, "state") == "running" && state == HostState.Unresponsive && !run.ExpectedStop)
                        SetState(HostState.Running, "主机已恢复响应，业务页面可正常访问。");
                }
                else if (type == "error")
                {
                    run.ReportedError = true;
                    run.LastError = Clean(Value(message, "message"), 600);
                    ClearToken();
                    SetState(Value(message, "code") == "HOST_IN_USE" ? HostState.Blocked : HostState.Error, run.LastError);
                    AddActivity(run.LastError);
                    UpdateSetup();
                }
                else if (type == "notice") AddActivity(Value(message, "message"));
                else if (type == "stopping")
                {
                    if (!run.ReportedError) SetState(HostState.Stopping, "正在完成保存和备份，请不要关机或拔盘。");
                }
                else if (type != "hello" && type != "stopped") throw new InvalidDataException();
            }
            catch (Exception)
            {
                run.ReportedError = true;
                run.LastError = "管理窗口与主机的通信格式不一致。已请求停止；请维护人员重新生成完整的同一版交付包。";
                SetState(HostState.Error, run.LastError);
                ClearToken();
                run.Send("stop", null);
                AddActivity(run.LastError);
            }
        }

        private void CommunicationLost(HostRun run)
        {
            if (current != run || run.ExpectedStop) return;
            SetState(HostState.Unresponsive, "主机连接中断，正在确认是否已停止。请稍候。");
        }

        private void HostExited(HostRun run, int code)
        {
            if (current != run) return;
            if (accountSetupReply != null) accountSetupReply.TrySetException(new IOException("本机主机已退出，请启动后再设置账号。"));
            bool restart = restartAfterStop && run.ExpectedStop && code == 0 && !run.ReportedError;
            restartAfterStop = false;
            current = null;
            ClearToken();
            run.Dispose();
            if (ContinueUpdateAfterExit(run, code)) return;
            if (ContinueLanAfterExit(run, code)) return;
            if (code == 0 && run.ExpectedStop && !run.ReportedError)
            {
                SetState(HostState.Stopped, "主机已停止，继续工作时请点击“启动主机”。");
                AddActivity("主机已安全停止；未停止其他程序。");
            }
            else if (!run.ReportedError)
            {
                SetState(HostState.Error, "中心进程已退出（代码 " + code + "）。" +
                    (String.IsNullOrEmpty(run.LastError) ? "请检查程序完整性、配置和数据目录权限，再尝试启动。" : run.LastError));
                AddActivity("主机进程退出，代码 " + code + "。");
            }
            else RefreshControls();
            runMeta.Text = "";
            UpdateSetup();
            if (exitAfterStop)
            {
                if (code != 0 || run.ReportedError)
                    MessageBox.Show(this, "主机已退出，但停止过程报告了异常。请维护人员检查业务数据目录中的 logs 文件夹后再使用。\n\n" + Clean(run.LastError, 400),
                        "停止时有异常", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                FinishExit();
            }
            else if (restart) StartHost();
        }

        private void StopHost(bool restart)
        {
            if (creatingAccount) { ShowNotice("请先完成或关闭账号设置窗口，再停止主机。"); return; }
            HostRun run = current;
            if (run == null || run.ExpectedStop) return;
            if (state == HostState.Blocked || run.ReportedError) return;
            restartAfterStop = restart;
            run.ExpectedStop = true;
            run.StopBegan = DateTime.UtcNow;
            ClearToken();
            SetState(HostState.Stopping, "正在等待当前请求与备份完成，随后释放账本。" + (restart ? "完成后会重新启动。" : "停止期间其他设备暂时无法同步。"));
            AddActivity(restart ? "已请求安全重启。" : "已请求安全停止。");
            run.Send("stop", null);
            UpdateSetup();
        }

        private void RequestExit()
        {
            if (creatingAccount) { ShowNotice("请先完成或关闭账号设置窗口。"); return; }
            if (configuringLan)
            {
                if (pendingLan && current != null && current.ExpectedStop &&
                    (DateTime.UtcNow - current.StopBegan).TotalSeconds >= 30)
                {
                    pendingLan = configuringLan = resumeAfterLan = false;
                    AddActivity("已取消尚未打开的局域网向导；正在处理停止超时。");
                }
                else { ShowNotice("请先完成或关闭局域网向导，再退出主机窗口。不会在维护过程中重新启动账本。"); return; }
            }
            if (updating) { ShowNotice("正在校验和交接程序，请等待完成后再停止并退出。收起窗口不会中断更新。"); return; }
            if (current == null || (current.ReportedError && !current.Ready)) { FinishExit(); return; }
            if (current.ExpectedStop && (DateTime.UtcNow - current.StopBegan).TotalSeconds >= 30)
            {
                if (MessageBox.Show(this, "主机仍在等待请求或备份完成。建议继续等待。\n\n是否强制退出本窗口及其托管主机？这可能中断当前备份；未完成备份不能用于恢复。\n不会停止其他主机或其他 Node 程序。",
                    "仍在安全停止", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2) == DialogResult.Yes)
                    FinishExit();
                return;
            }
            if (exitAfterStop) return;
            if (MessageBox.Show(this, "停止中心主机后，其他设备将暂时无法同步。\n\n是否等待当前请求和备份完成，然后停止并退出？",
                "停止并退出", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != DialogResult.Yes) return;
            exitAfterStop = true;
            restartAfterStop = false;
            if (current.ReportedError)
            {
                current.ExpectedStop = true;
                current.StopBegan = DateTime.UtcNow;
                current.Send("stop", null);
            }
            else StopHost(false);
        }

        private void FinishExit()
        {
            allowExit = true;
            Close();
        }

        private void TimerTick(object sender, EventArgs e)
        {
            tick++;
            HostRun run = current;
            if (run != null)
            {
                if (tick % 2 == 0 && !run.ExpectedStop) run.Send("status", delegate { Ui(delegate { CommunicationLost(run); }); });
                if (run.Ready && !run.ExpectedStop)
                {
                    TimeSpan uptime = DateTime.UtcNow - run.Began;
                    runMeta.Text = "已运行 " + ((int)uptime.TotalHours).ToString("00") + ":" +
                        uptime.Minutes.ToString("00") + ":" + uptime.Seconds.ToString("00");
                    tips.SetToolTip(runMeta, "主机进程 " + run.Process.Id + "；每 2 秒检查连接。");
                    if ((DateTime.UtcNow - run.LastReply).TotalSeconds > 10 && state == HostState.Running)
                        SetState(HostState.Unresponsive, "主机暂未响应，请稍等；仍无响应可点击“停止主机”。");
                }
                if (run.ExpectedStop && (DateTime.UtcNow - run.StopBegan).TotalSeconds > 30)
                {
                    stateDetail.Text = "仍在完成保存或备份，请继续等待。强制退出可能损坏数据。";
                    tips.SetToolTip(stateDetail, stateDetail.Text);
                }
            }
            if (revealUntil != DateTime.MinValue && DateTime.UtcNow >= revealUntil)
                MaskToken();
            if (clipboardToken != null && DateTime.UtcNow >= copiedUntil) ClearClipboard();
        }

        private void UpdateSetup()
        {
            bool available = !String.IsNullOrEmpty(setupToken) && current != null && !current.ExpectedStop && state == HostState.Running;
            tokenRow.Visible = available && options.AdvancedSetup;
            if (setupAccountButton != null) setupAccountButton.Visible = available && !options.AdvancedSetup;
            initializedNote.Visible = !available;
            if (available)
            {
                if (options.AdvancedSetup) tokenRow.BringToFront();
                else setupAccountButton.BringToFront();
                setupTitle.Text = "首次使用 · 创建账号";
                setupHint.Text = options.AdvancedSetup ?
                    "维护模式：初始化口令只交给首位管理员，请勿发群或截图。" :
                    "设置自己的用户名和密码。";
            }
            else if (initialized)
            {
                setupTitle.Text = "管理员账号已创建";
                setupHint.Text = "在业务页面登录。";
                initializedNote.Text = "添加同事：系统管理 → 连接同事电脑。";
            }
            else
            {
                setupTitle.Text = "管理员账号";
                setupHint.Text = state == HostState.Blocked ? "这份账目已在另一个窗口打开，请使用原窗口。" :
                    "主机启动后，可以在这里设置账号。";
                initializedNote.Text = options.AdvancedSetup ? "口令不写入日志、网址或配置文件。" : "";
            }
        }

        private void RevealToken()
        {
            if (String.IsNullOrEmpty(setupToken)) return;
            if (!tokenBox.UseSystemPasswordChar) { MaskToken(); return; }
            tokenBox.Text = setupToken;
            tokenBox.UseSystemPasswordChar = false;
            showToken.Text = "隐藏";
            revealUntil = DateTime.UtcNow.AddSeconds(30);
        }

        private void MaskToken()
        {
            tokenBox.UseSystemPasswordChar = true;
            tokenBox.Text = String.IsNullOrEmpty(setupToken) ? "" : new string('●', 24);
            showToken.Text = "显示";
            revealUntil = DateTime.MinValue;
        }

        private void CopyToken()
        {
            if (String.IsNullOrEmpty(setupToken)) return;
            try
            {
                var data = new DataObject();
                data.SetText(setupToken, TextDataFormat.UnicodeText);
                data.SetData("CanIncludeInClipboardHistory", false, new MemoryStream(new byte[4]));
                data.SetData("CanUploadToCloudClipboard", false, new MemoryStream(new byte[4]));
                data.SetData("ExcludeClipboardContentFromMonitorProcessing", false, new MemoryStream(new byte[4]));
                Clipboard.SetDataObject(data, true);
                clipboardToken = setupToken;
                copiedUntil = DateTime.UtcNow.AddSeconds(60);
                AddActivity("口令已复制；60 秒后尽力清除本次剪贴板内容，请及时完成初始化。");
            }
            catch (Exception) { ShowNotice("剪贴板正被其他程序占用，请稍后重试，或点击“显示”后手动输入。"); }
        }

        private void ClearClipboard()
        {
            if (clipboardToken == null) return;
            try
            {
                if (Clipboard.ContainsText() && Clipboard.GetText(TextDataFormat.UnicodeText) == clipboardToken) Clipboard.Clear();
                clipboardToken = null;
            }
            catch (Exception) { copiedUntil = DateTime.UtcNow.AddSeconds(2); }
        }

        private void ClearToken()
        {
            setupToken = null;
            tokenBox.Text = "";
            tokenBox.UseSystemPasswordChar = true;
            showToken.Text = "显示";
            revealUntil = DateTime.MinValue;
            ClearClipboard();
        }

        private void OpenBusiness()
        { OpenBusiness(false); }
        private void OpenBusiness(bool background)
        {
            if (!initialized && !options.AdvancedSetup) { OpenAccountSetup(); return; }
            if (String.IsNullOrEmpty(businessUrl)) return;
            try { Process.Start(LaunchOptions.ClientStart(applicationDirectory, options.ConfigFile, businessUrl, background)); }
            catch (Exception error) { ShowNotice("独立业务窗口未能打开。\n" + Clean(error.Message, 240)); }
        }

        private async Task OpenDirectory(string directory, bool backup)
        {
            if (String.IsNullOrEmpty(businessUrl)) return;
            try
            {
                bool exists = await Task.Run(delegate { return Directory.Exists(directory); });
                if (IsDisposed || Disposing) return;
                if (!exists)
                {
                    if (!backup || state == HostState.Blocked) { ShowNotice("目录尚不存在或当前账号无法访问。请核对路径与权限；没有打开其他目录。"); return; }
                    if (MessageBox.Show(this, "备份目录尚不存在。是否创建并打开这个空文件夹？\n\n" + directory +
                        "\n\n创建目录不代表已生成备份；完整备份请在业务页面操作。", "打开备份目录", MessageBoxButtons.YesNo,
                        MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) != DialogResult.Yes) return;
                    await Task.Run(delegate { Directory.CreateDirectory(directory); });
                    if (IsDisposed || Disposing) return;
                }
                string explorer = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Windows), "explorer.exe");
                Process.Start(new ProcessStartInfo(explorer, LaunchOptions.Quote(directory)) { UseShellExecute = true });
            }
            catch (Exception error) { ShowNotice("目录无法打开：" + Clean(error.Message, 450)); }
        }

        private void ShowNotice(string message)
        {
            AddActivity(message);
            MessageBox.Show(this, Clean(message, 600), "园区租赁 · 提示", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void HideToTray()
        {
            MaskToken();
            Hide();
            ShowInTaskbar = false;
            if (!balloonShown)
            {
                balloonShown = true;
                tray.ShowBalloonTip(4000, "园区租赁已收起", current != null && current.Ready
                    ? "主机继续运行。双击此图标返回；需要停机请右键“停止并退出”。"
                    : "双击此图标查看真实状态；收起窗口不会接管或停止其他主机。", ToolTipIcon.Info);
            }
        }

        private void ShowManager()
        {
            ShowInTaskbar = true;
            Show();
            WindowState = FormWindowState.Normal;
            Activate();
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            if (!allowExit && e.CloseReason == CloseReason.UserClosing)
            {
                e.Cancel = true;
                HideToTray();
                return;
            }
            if (!allowExit && current != null) current.Send("stop", null);
            base.OnFormClosing(e);
        }

        protected override void WndProc(ref Message message)
        {
            if (message.Msg == 0x02e0 && uiScale > 0)
            {
                float nextScale = (message.WParam.ToInt64() & 0xffff) / 96f;
                Rectangle suggested = Native.SuggestedBounds(message.LParam);
                base.WndProc(ref message);
                if (nextScale > 0 && Math.Abs(nextScale - uiScale) > 0.01f)
                {
                    SuspendLayout();
                    float factor = nextScale / uiScale;
                    foreach (Control control in Controls) control.Scale(new SizeF(factor, factor));
                    uiScale = nextScale;
                    MinimumSize = new Size((int)(920 * uiScale), (int)(600 * uiScale));
                    Bounds = suggested;
                    ResumeLayout(true);
                }
                return;
            }
            base.WndProc(ref message);
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                timer.Stop();
                timer.Dispose();
                ClearClipboard();
                tray.Visible = false;
                if (tray.ContextMenuStrip != null) tray.ContextMenuStrip.Dispose();
                tray.Dispose();
                tips.Dispose();
                if (current != null) { current.Dispose(); current = null; }
                if (updateProcessJob != null) { updateProcessJob.Dispose(); updateProcessJob = null; }
                if (lanProcessJob != null) { lanProcessJob.Dispose(); lanProcessJob = null; }
            }
            base.Dispose(disposing);
        }
    }

    internal static class Program
    {
        [STAThread]
        private static void Main(string[] args)
        {
            AppContext.SetSwitch("Switch.UseLegacyAccessibilityFeatures", false);
            AppContext.SetSwitch("Switch.UseLegacyAccessibilityFeatures.2", false);
            AppContext.SetSwitch("Switch.UseLegacyAccessibilityFeatures.3", false);
            Native.EnableDpiAwareness();
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.SetUnhandledExceptionMode(UnhandledExceptionMode.ThrowException);
            try
            {
                var options = LaunchOptions.Parse(args);
                if (FullUpdateLaunch.Resume(options)) return;
                if (LaunchOptions.RunJoinedComputer(options)) return;
                using (var manager = new Manager(options)) Application.Run(manager);
            }
            catch (Exception error)
            {
                string message = Regex.Replace(error.Message ?? "未知错误", "[\\x00-\\x1f\\x7f]+", " ");
                if (message.Length > 600) message = message.Substring(0, 600);
                MessageBox.Show("管理窗口未能继续运行。自有主机已随窗口退出，不会影响其他主机。\n\n" + message,
                    "园区租赁 · 主机管理", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
