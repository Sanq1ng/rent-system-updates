    internal sealed class LaunchOptions
    {
        public string ConfigFile;
        public bool NoBrowser;
        public bool Minimized;
        public bool AdvancedSetup;
        public bool BackgroundClient;
        public string UpdateJob;

        public static LaunchOptions Parse(string[] args)
        {
            var result = new LaunchOptions();
            for (int i = 0; i < args.Length; i++)
            {
                if (args[i] == "--no-browser") result.NoBrowser = true;
                else if (args[i] == "--minimized") result.Minimized = true;
                else if (args[i] == "--background-client") result.BackgroundClient = true;
                else if (args[i] == "--advanced-setup") result.AdvancedSetup = true;
                else if (args[i] == "--config" && result.ConfigFile == null && i + 1 < args.Length && !args[i + 1].StartsWith("--"))
                    result.ConfigFile = Path.GetFullPath(args[++i]);
                else if (args[i] == "--update-job" && result.UpdateJob == null && i + 1 < args.Length &&
                    Regex.IsMatch(args[i + 1], "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$")) result.UpdateJob = args[++i];
                else throw new ArgumentException("不支持或不完整的启动参数。图形入口支持 --config 配置文件、--no-browser 和 --minimized。诊断检查请使用 启动主机.cmd --check。");
            }
            return result;
        }

        public static string FindApplication()
        {
            string home = AppDomain.CurrentDomain.BaseDirectory;
            string[] candidates = { home, Path.Combine(home, "程序"), Path.Combine(home, "交付", "园区租赁-v0.1", "程序") };
            foreach (string candidate in candidates)
            {
                if (!File.Exists(Path.Combine(candidate, "host.cjs"))) continue;
                if (!File.Exists(Path.Combine(candidate, "runtime", "node.exe")))
                    throw new IOException("已找到程序，但缺少随包运行组件 runtime\\node.exe。请使用完整交付包，不要只复制启动图标。");
                return Path.GetFullPath(candidate);
            }
            throw new IOException("未找到完整交付程序。请保留根目录下的“交付\\园区租赁-v0.1\\程序”，或直接打开交付包“程序”目录中的“园区租赁主机.exe”。");
        }

        public static string Quote(string value)
        {
            var result = new StringBuilder("\"");
            int slashes = 0;
            foreach (char character in value)
            {
                if (character == '\\') { slashes++; continue; }
                result.Append('\\', character == '"' ? slashes * 2 + 1 : slashes);
                result.Append(character);
                slashes = 0;
            }
            return result.Append('\\', slashes * 2).Append('"').ToString();
        }
        internal static ProcessStartInfo ClientStart(string program, string config, string origin, bool background)
        {
            string root = Directory.GetParent(program).FullName;
            if (config != null) root = Directory.GetParent(Path.GetDirectoryName(config)).FullName;
            string executable = Path.Combine(program, "client-windows", "园区租赁.exe");
            if (!File.Exists(executable)) throw new IOException("缺少独立业务窗口组件，请使用完整的新版本程序；没有跳转浏览器。");
            return new ProcessStartInfo(executable, "--state " + Quote(Path.Combine(root, "电脑端资料")) +
                (origin == null ? "" : " --origin " + Quote(origin)) + (background ? " --background" : "")) {
                UseShellExecute = false, WorkingDirectory = Path.GetDirectoryName(executable)
            };
        }
        internal static bool RunJoinedComputer(LaunchOptions options)
        {
            string program = FindApplication(), root = Directory.GetParent(program).FullName;
            string role = Path.Combine(root, "配置", "电脑角色.json");
            if (!File.Exists(role)) return false;
            if (new FileInfo(role).Length > 2048) throw new IOException("电脑职责配置无效。");
            var serializer = new JavaScriptSerializer();
            var record = serializer.Deserialize<Dictionary<string, object>>(File.ReadAllText(role, Encoding.UTF8));
            var installation = serializer.Deserialize<Dictionary<string, object>>(File.ReadAllText(Path.Combine(root, "installation.json"), Encoding.UTF8));
            if (record.Count != 4 || (string)record["format"] != "industrial-rent-machine-role" ||
                Convert.ToInt32(record["formatVersion"]) != 1 || !Equals(record["installationId"], installation["installationId"]))
                throw new IOException("电脑职责不属于此安装，未创建账本。");
            if ((string)record["mode"] == "host") return false;
            if ((string)record["mode"] != "client") throw new IOException("电脑职责配置无效，未创建账本。");
            using (var client = Process.Start(ClientStart(program, options.ConfigFile, null, options.BackgroundClient || options.Minimized)))
                client.WaitForExit();
            return true;
        }
    }

    internal sealed class HostRun : IDisposable
    {
        private static readonly Encoding InputEncoding = new UTF8Encoding(false, true);
        public readonly Process Process;
        public readonly OwnedJob Job;
        public readonly DateTime Began = DateTime.UtcNow;
        public DateTime LastReply = DateTime.UtcNow;
        public DateTime StopBegan;
        public bool ExpectedStop;
        public bool ReportedError;
        public bool Ready;
        public string UpdateJobId;
        public bool UpdateRestart;
        public bool UpdateRecovery;
        public string LastError = "";
        private readonly object writing = new object();
        private int statusPending;
        private int disposed;

        public HostRun(Process process, OwnedJob job) { Process = process; Job = job; }

        public void Send(string command, Action failed)
        {
            bool status = command == "status";
            SendFrame(command == "start" ? "{\"command\":\"start\",\"protocol\":2}" : "{\"command\":\"" + command + "\"}", status, failed);
        }

        public void SendUpdate(string command, string jobId)
        {
            Guid id;
            if (!Guid.TryParse(jobId, out id)) throw new InvalidDataException("Invalid update job identifier.");
            SendFrame("{\"command\":\"" + command + "\",\"jobId\":\"" + id.ToString("D") + "\"}", false, null);
        }
        public void SendAccountSetup(string frame, Action failed) { SendFrame(frame, false, failed); }

        private void SendFrame(string frame, bool status, Action failed)
        {
            if (status && Interlocked.Exchange(ref statusPending, 1) != 0) return;
            Task.Run(delegate {
                byte[] bytes = null;
                try
                {
                    bytes = InputEncoding.GetBytes(frame + "\n");
                    lock (writing)
                    {
                        if (Volatile.Read(ref disposed) != 0) return;
                        // The Framework text writer uses the console code page, not the host's UTF-8 protocol.
                        Stream input = Process.StandardInput.BaseStream;
                        input.Write(bytes, 0, bytes.Length);
                        input.Flush();
                    }
                }
                catch (IOException) { if (failed != null) failed(); }
                catch (InvalidOperationException) { if (failed != null) failed(); }
                catch (EncoderFallbackException) { if (failed != null) failed(); }
                finally
                {
                    if (bytes != null) Array.Clear(bytes, 0, bytes.Length);
                    if (status) Interlocked.Exchange(ref statusPending, 0);
                }
            });
        }

        public void Dispose()
        {
            if (Interlocked.Exchange(ref disposed, 1) != 0) return;
            Job.Dispose();
            Process.Dispose();
        }
    }

