"use strict";

const crypto = require("node:crypto");

const DESKTOP_SCHEMA = `
  CREATE TABLE desktop_devices(
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL REFERENCES users(id),
    installation_id TEXT NOT NULL,
    token_hash TEXT NOT NULL UNIQUE,
    session_hash TEXT NOT NULL,
    user_version INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL,
    revoked_at INTEGER
  );
  CREATE UNIQUE INDEX desktop_devices_installation ON desktop_devices(installation_id) WHERE revoked_at IS NULL;
  CREATE INDEX desktop_devices_user ON desktop_devices(user_id);
  CREATE TABLE inbox_reads(
    user_id TEXT NOT NULL REFERENCES users(id),
    event_id TEXT NOT NULL,
    PRIMARY KEY(user_id,event_id)
  );
`;

const DESKTOP_COLUMNS = {
  desktop_devices: "id:TEXT,user_id:TEXT,installation_id:TEXT,token_hash:TEXT,session_hash:TEXT,user_version:INTEGER,created_at:INTEGER,expires_at:INTEGER,revoked_at:INTEGER",
  inbox_reads: "user_id:TEXT,event_id:TEXT",
};

function upgradeOwnerDefaults(db, at) {
  let owners = 0;
  for (const row of db.prepare("SELECT id,json FROM users").all()) {
    const before = JSON.parse(row.json);
    if (before.roles.length !== 1 || before.roles[0] !== "admin") continue;
    const after = { ...before, roles: ["admin", "viewer"], allParks: true, parks: [],
      receiveReminders: true, version: before.version + 1 };
    db.prepare("UPDATE users SET json=? WHERE id=?").run(JSON.stringify(after), row.id);
    db.prepare("DELETE FROM sessions WHERE user_id=?").run(row.id);
    const entry = { id: crypto.randomUUID(), action: "admin.owner-defaults", actor: row.id,
      at: new Date(at).toISOString(), detail: "升级为老板岗位：管理、查看和提醒；不授予录入或审核", before, after };
    db.prepare("INSERT INTO audit(id,action,actor,at,json) VALUES(?,?,?,?,?)")
      .run(entry.id, entry.action, entry.actor, entry.at, JSON.stringify(entry));
    owners++;
  }
  return owners;
}

module.exports = { DESKTOP_SCHEMA, DESKTOP_COLUMNS, upgradeOwnerDefaults };
