    const payload = validatePayload(value);
    const enrollment = payload.kind === "rent-push-enrollment";
    return { title: "园区租赁", options: {
      body: enrollment ? "请回到应用确认开启设备通知。" : payload.body,
      tag: `rent-push-${enrollment ? payload.enrollmentId : payload.deliveryId}`,
      data: payload,
    } };
  }

  async function postReceipt(value, stage, fetcher = globalThis.fetch.bind(globalThis)) {
    const payload = validatePayload(value);
    insist(payload.kind !== "rent-push-enrollment" && ["received", "opened"].includes(stage),
      "PUSH_RECEIPT", "通知回执无效。");
