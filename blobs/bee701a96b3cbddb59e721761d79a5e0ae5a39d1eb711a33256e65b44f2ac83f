      insist(response.ok && !response.redirected, "PUSH_RECEIPT_PENDING", "回执尚未由主机确认。");
      const result = await response.json();
      insist(result?.ok === true && ["received", "opened"].includes(result.stage), "PUSH_RECEIPT_PENDING", "回执尚未由主机确认。");
