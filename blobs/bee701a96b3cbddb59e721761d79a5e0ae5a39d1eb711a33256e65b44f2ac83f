    }
    insist(exact(value, ["kind", "deliveryId", "receiptToken", "title", "body", "url"]) &&
      Object.hasOwn(CONTENT, value.kind) && UUID.test(value.deliveryId) && SECRET.test(value.receiptToken) &&
      value.title === "园区租赁" && value.body === CONTENT[value.kind] && value.url === OPEN_PATH,
    "PUSH_PAYLOAD", "设备通知消息无效。");
    return { kind: value.kind, deliveryId: value.deliveryId, receiptToken: value.receiptToken,
      title: "园区租赁", body: CONTENT[value.kind], url: OPEN_PATH };
  }

