    if (!device || typeof device.source !== "string" || !device.source || typeof device.target !== "string" ||
        !device.target || device.sameDisk || device.source === device.target) {
      fail("这个文件夹仍在账本所在的物理硬盘上，请换另一块硬盘或移动硬盘。");
    }
    return { directory, device, dataDir: identityPath(dataDir) };
