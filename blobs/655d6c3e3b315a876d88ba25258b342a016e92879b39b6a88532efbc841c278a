    }
    if (markerExists) verifyOwner(marker, owner);
    else writeFile(marker, Buffer.from(JSON.stringify(owner)));
    const target = { ...candidate, version: expectedVersion + 1, actorId };
    store.transaction(() => {
      store.set(TARGET_KEY, JSON.stringify(target));
      store.set("independent_backup_pending", "1");
      store.set("independent_backup_success", "");
      recordChange(actorId, old, target);
    });
    return status();
  }
  async function copy(localBackup) {
