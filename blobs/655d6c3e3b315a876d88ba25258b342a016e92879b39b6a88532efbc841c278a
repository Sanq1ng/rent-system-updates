      fail("备份位置已被修改，请重新打开系统管理后再保存。");
    }
    validateDirectory(candidate.directory);
    ensureDirectory(candidate.directory);
    const marker = path.join(candidate.directory, MARKER);
    const owner = { format: "rent-independent-backup", serverId: store.serverId, device: candidate.device.target };
    let markerExists;
    try { fs.lstatSync(marker); markerExists = true; }
    catch (error) {
      if (error.code !== "ENOENT") throw error;
