      const verified = await verifyBackup(localBackup.path);
      const destination = path.join(target.directory, verified.name);
      if (fs.existsSync(destination)) fail("独立备份目标已存在，不会覆盖。");
      const staging = destination + ".incomplete-" + crypto.randomUUID();
      fs.mkdirSync(staging, { mode: 0o700 });
