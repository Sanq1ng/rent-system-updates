    if (!target) return null;
    try {
      if (target.dataDir !== identityPath(dataDir)) fail("账本位置变了，请重新设置独立备份文件夹。");
      const actual = await prepare(target.directory);
      if (actual.device.source !== target.device.source || actual.device.target !== target.device.target) {
        fail("备份盘或账本所在的盘变了，请重新确认备份位置。");
      }
      const marker = path.join(target.directory, MARKER);
