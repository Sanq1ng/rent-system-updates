      if (after.device.source !== target.device.source || after.device.target !== target.device.target) fail("备份期间磁盘发生变化，副本未标记为完成。");
      assertDirectory(target.directory);
      assertDirectory(staging);
      verifyOwner(marker, { format: "rent-independent-backup", serverId: store.serverId, device: target.device.target });
      fs.renameSync(staging, destination);
      const success = { createdAt: verified.createdAt, path: destination, bytes: verified.bytes, fileCount: verified.fileCount };
      store.transaction(() => {
        store.set("independent_backup_success", JSON.stringify(success));
        store.set("independent_backup_pending", "0");
      });
      return success;
    } catch (error) {
      fail("本机备份已完成，但独立备份未完成。请检查备份盘是否接好、空间是否足够，再重试。" +
        (error.code === "INDEPENDENT_BACKUP" ? " " + error.message : ""), error);
    }
