.mobile-only, .mobile-menu-backdrop { display: none; }
.install-help { width: min(480px, calc(100vw - 28px)); max-height: calc(100dvh - 28px); overflow: auto; overscroll-behavior: contain; padding: 24px; border: 1px solid var(--line); border-radius: 16px; color: var(--text); }
.install-help::backdrop { background: #10293499; }
.install-help h2 { margin-bottom: 14px; }
.install-help p { margin-bottom: 18px; line-height: 1.8; }
.table-wrap:focus-visible { outline: 3px solid #74bdb2; outline-offset: -3px; }
.sidebar { overflow-y: auto; }
.workspace, main, .card, .card-pad, .card-header > div, .wizard-layout > *, .dashboard-grid > * { min-width: 0; }
.card-pad > p, .list-row small, .attachment-row > :first-child { overflow-wrap: anywhere; }
.push-consent { display: flex; align-items: flex-start; gap: 12px; margin-top: 18px; line-height: 1.8; }
.push-consent input { flex-shrink: 0; margin-top: 5px; }

@media (max-width: 800px) {
  :root { --sidebar-width: 0px; }
  body { font-size: 15px; }
  .mobile-only { display: inline-flex; }
  .workspace { margin-left: 0; min-height: 100dvh; }
  .sidebar {
    width: min(320px, calc(100vw - 48px)); height: 100dvh;
    padding: max(18px, env(safe-area-inset-top)) 16px max(20px, env(safe-area-inset-bottom));
    transform: translateX(-100%); visibility: hidden; z-index: 60;
  }
  .mobile-menu-open { overflow: hidden; }
  .mobile-menu-open .sidebar { transform: translateX(0); visibility: visible; }
  .mobile-menu-backdrop:not([hidden]) { display: block; position: fixed; inset: 0; width: 100%; height: 100dvh; border: 0; background: #10293499; z-index: 55; }
  .sidebar .brand { justify-content: flex-start; margin-bottom: 18px; }
  .sidebar .brand > span:last-child, .sidebar .nav-item > span,
  .sidebar .sidebar-link > span, .sidebar .nav-count { display: block; }
  .sidebar .nav-item, .sidebar .sidebar-link { justify-content: flex-start; min-height: 48px; padding: 12px 14px; font-size: 15px; }
  .sidebar .nav-count { margin-left: auto; }
  .sidebar .sidebar-bottom { padding-top: 20px; }
  .mobile-identity { display: block; color: #b9ccd3; padding: 0 14px 16px; font-size: 13px; overflow-wrap: anywhere; }
  .workspace .topbar { gap: 9px; min-height: 0; padding: max(10px, env(safe-area-inset-top)) 12px 10px; }
  .page-location { width: 100%; gap: 8px; }
  .page-location .breadcrumb { display: flex; flex: 1; min-width: 0; white-space: normal; font-size: 15px; }
  .page-location .breadcrumb strong { overflow-wrap: anywhere; }
  #page-back { font-size: 12px; max-width: 48%; white-space: normal; line-height: 1.4; }
  #mobile-menu-button { flex-shrink: 0; }
  .topbar-tools { width: 100%; gap: 8px; }
  .global-search { flex: 1; width: auto; min-width: 80px; padding: 7px 9px; }
  .global-search input { font-size: 16px; min-height: 28px; }
  .topbar-tools .notification-button { display: inline-flex; }
  .topbar-tools .role-control { display: none; }
  .connection-button { min-height: 44px; max-width: 132px; white-space: normal; font-size: 11px; text-align: left; }
  .notification-dot { width: 7px; height: 7px; right: 8px; top: 7px; }
  .prototype-ribbon { font-size: 11px; padding: 7px 14px; overflow-wrap: anywhere; }
  .prototype-ribbon > span { display: block; min-width: 0; }
  .prototype-ribbon .icon { margin-right: 5px; vertical-align: middle; }
  main { padding: 18px max(12px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)); }
  .workspace .card-pad { padding: 18px 14px; }
  .card-header { flex-wrap: wrap; padding: 16px 14px; }
  .page-heading { margin-bottom: 18px; }
  .page-heading h1 { font-size: 23px; }
  .heading-actions { flex-wrap: wrap; margin-top: 10px; }
  .metric { padding: 14px 12px; }
  .metric-number { font-size: clamp(17px, 5.6vw, 25px); overflow-wrap: anywhere; }
  .metric-label { font-size: 12px; }
  .metric-icon { display: none; }
  .metric-foot { font-size: 11px; }
  .workspace .list-row { padding: 14px 0; gap: 10px; flex-wrap: wrap; }
  .workspace .list-row > div { flex: 1 1 175px; }
  .collection-toolbar { flex-wrap: wrap; padding: 0 12px 12px; }
  .segmented { max-width: 100%; }
  .segmented button { min-height: 44px; padding: 8px 10px; font-size: 13px; }
  .button, .button.small, .icon-button, .text-button, .password-toggle { min-height: 44px; }
  .button, .button.small { white-space: normal; font-size: 14px; padding: 10px 12px; line-height: 1.5; }
  .icon-button { min-width: 44px; width: 44px; }
  .text-button { font-size: 14px; }
  .workspace .toolbar { gap: 10px; }
  .workspace .toolbar label { max-width: 100%; flex-wrap: wrap; font-size: 13px; }
  .workspace .toolbar input, .workspace .toolbar select { min-height: 44px; font-size: 16px; max-width: 100%; }
  .field input:not([type="checkbox"]), .field select, .field textarea,
  .workspace .compact-fields .field input, .workspace .compact-fields .field select { font-size: 16px; min-height: 44px; min-width: 0; }
  .field input[type="file"] { width: 100%; font-size: 13px; padding: 9px 0; }
  .field, .field label, .field input, .field select, .field textarea { min-width: 0; }
  .selection-grid label, .file-choice { min-height: 44px; align-items: center; }
  input[type="checkbox"] { width: 20px; height: 20px; flex-shrink: 0; }
  .workspace .wizard-form-card { padding: 19px 14px; }
  .workspace .wizard-form-card .form-grid { gap: 16px; }
  .location-editor { padding: 0 12px 12px; }
  .location-actions, .attachment-row { flex-wrap: wrap; }
  .attachment-row { padding: 6px 0; }
  .attachment-row > :first-child { min-width: 0; flex: 1 1 160px; }
  .workspace .steps { gap: 5px; padding: 12px 6px; }
  .step { min-width: 0; font-size: 11px; }
  .workspace .wizard-footer { padding: 12px 12px max(12px, env(safe-area-inset-bottom)); border-radius: 12px; }
  .wizard-footer > div:first-child { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px; }
  .wizard-footer > div:first-child .hint { margin: 0; font-size: 11px; }
  .wizard-footer .button-row { gap: 8px; }
  .wizard-footer .button-row > .button { flex: 1; }
  .contract-metadata { grid-template-columns: 1fr; padding: 14px; }
  .workspace .table-wrap { max-width: 100%; overscroll-behavior-x: contain; }
  .workspace .table-wrap::before { content: "左右滑动，查看完整表格"; display: block; color: var(--muted); font-size: 12px; padding: 8px 12px; }
  .workspace .table-wrap td, .workspace .table-wrap th { font-size: 13px; }
  .table-footer { flex-wrap: wrap; padding: 12px; gap: 8px; }
  .network-banner { margin: 12px 12px 0; padding: 13px; overflow-wrap: anywhere; }
  .update-notice { align-items: stretch; }
  .update-notice .button-row { width: 100%; }
  .update-notice .button { flex: 1; }
  .auth-screen { min-height: 100dvh; padding: max(18px, env(safe-area-inset-top)) 14px max(18px, env(safe-area-inset-bottom)); }
  .auth-card { padding: 25px 20px; }
  .auth-card h1 { font-size: 27px; }
  .auth-card .eyebrow { overflow-wrap: anywhere; }
  .auth-card .notice { overflow-wrap: anywhere; }
  .modal, .modal.wide { width: calc(100vw - 20px); max-width: calc(100vw - 20px); max-height: calc(100dvh - 20px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); margin: auto; padding: 0; }
  .modal[open] { display: flex; flex-direction: column; }
  .modal-header { flex: 0 0 auto; padding: 16px 14px; gap: 12px; }
  .modal-header > div { min-width: 0; overflow-wrap: anywhere; }
  .modal-header h2 { font-size: 18px; }
  .modal-body { flex: 1 1 auto; min-height: 0; max-height: none; overflow: auto; overscroll-behavior: contain; padding: 16px 14px; }
  .modal-body .split { grid-template-columns: 1fr; }
  .modal-actions { flex: 0 0 auto; flex-wrap: wrap; padding: 12px 14px max(12px, env(safe-area-inset-bottom)); }
  .modal-actions .button { flex: 1; }
  .modal-body .table-wrap { max-width: 100%; }
  .modal-body .mini-card { overflow-wrap: anywhere; }
  .toast-container { left: 12px; right: 12px; bottom: max(14px, env(safe-area-inset-bottom)); width: auto; max-width: none; transform: none; }
  .toast-container .toast { width: 100%; max-width: none; font-size: 14px; overflow-wrap: anywhere; }
}

@media (max-width: 380px) {
  .workspace .compact-fields { grid-template-columns: 1fr; }
  .auth-card { padding: 22px 16px; }
  .plan-summary > div { flex-wrap: wrap; }
}

@media print {
  .mobile-only, .mobile-menu-backdrop, .install-help { display: none !important; }
}
